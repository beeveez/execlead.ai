{
  "name": "NetworkBadge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "badge_type": {
      "type": "string",
      "enum": [
        "founding_member",
        "verified_executive",
        "top_contributor",
        "ai_pioneer",
        "mentor",
        "thought_leader",
        "transformation_leader",
        "community_builder",
        "executive_influencer"
      ],
      "default": "top_contributor"
    },
    "awarded_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "badge_type"
  ]
}