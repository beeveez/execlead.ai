{
  "name": "Executive Identity Auto-Sync",
  "description": "Auto-synthesize the member's Executive Identity Graph\u2122 whenever an Executive Success Story is created or updated \u2014 keeping one canonical identity as the single source of truth.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ExecutiveSuccessStory"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "executive_identity_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncExecutiveIdentityGraph",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncExecutiveIdentityGraph"
  }
}