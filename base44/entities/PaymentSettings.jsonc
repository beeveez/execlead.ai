{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wise",
        "apple_pay",
        "google_pay",
        "paynow",
        "bank_transfer",
        "enterprise_invoice"
      ],
      "default": "stripe"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "pending",
        "error"
      ],
      "default": "disconnected"
    },
    "publishable_key": {
      "type": "string"
    },
    "secret_key": {
      "type": "string"
    },
    "webhook_secret": {
      "type": "string"
    },
    "supported_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_currency": {
      "type": "string",
      "default": "USD"
    },
    "tax_enabled": {
      "type": "boolean",
      "default": true
    },
    "tax_engine_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "disabled"
      ],
      "default": "automatic"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "trial_enabled": {
      "type": "boolean",
      "default": true
    },
    "trial_duration_days": {
      "type": "number",
      "default": 14
    },
    "min_coupon_value": {
      "type": "number",
      "default": 0
    },
    "max_coupon_value": {
      "type": "number",
      "default": 100
    },
    "refund_window_days": {
      "type": "number",
      "default": 30
    },
    "parent_company": {
      "type": "string",
      "default": "Meridian Wellspring Holdings Pte. Ltd."
    },
    "parent_company_country": {
      "type": "string",
      "default": "Singapore"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "provider"
  ]
}