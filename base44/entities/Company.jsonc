{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "logo_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "missing",
        "pending"
      ],
      "default": "pending"
    },
    "logo_validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "logo_error": {
      "type": "string"
    },
    "headquarters": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "founded": {
      "type": "number"
    },
    "fortune_ranking": {
      "type": "string"
    },
    "global_ranking": {
      "type": "string"
    },
    "forbes_ranking": {
      "type": "string"
    },
    "company_size": {
      "type": "string"
    },
    "revenue": {
      "type": "string"
    },
    "market_cap": {
      "type": "string"
    },
    "employee_count": {
      "type": "number",
      "default": 0
    },
