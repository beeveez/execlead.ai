{
  "name": "PartnerObjective",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "objectiveId": {
      "type": "string"
    },
    "partnerId": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "type": "string"
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "at_risk",
        "completed",
        "cancelled"
      ]
    },
    "successMetric": {
      "type": "string"
    },
    "targetValue": {
      "type": "number"
    },
    "actualValue": {
      "type": "number"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizationId",
    "objectiveId",
    "partnerId",
    "objective",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "sales"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "sales"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "sales"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    }
  }
}