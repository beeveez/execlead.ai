{
  "name": "TalentIntelligenceAuditEvent",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "actorId": {
      "type": "string"
    },
    "actorRole": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "analytics_viewed",
        "succession_viewed",
        "forecast_generated",
        "succession_calibrated",
        "masked_export"
      ]
    },
    "resource": {
      "type": "string"
    },
    "cohortId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizationId",
    "actorId",
    "eventType",
    "occurredAt"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "chro"
                  }
                },
                {
                  "user_condition": {
                    "role": "vp_talent_management"
                  }
                },
                {
                  "user_condition": {
                    "role": "leadership_development_head"
                  }
                },
                {
                  "user_condition": {
                    "role": "talent_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "hrbp"
                  }
                },
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "chro"
                  }
                },
                {
                  "user_condition": {
                    "role": "talent_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}