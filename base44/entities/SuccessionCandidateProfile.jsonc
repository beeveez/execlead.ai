{
  "name": "SuccessionCandidateProfile",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "cohortId": {
      "type": "string"
    },
    "employeeId": {
      "type": "string"
    },
    "targetRole": {
      "type": "string"
    },
    "readinessScore": {
      "type": "number",
      "default": 0
    },
    "promotionForecast": {
      "type": "string",
      "enum": [
        "ready_now",
        "ready_6_months",
        "ready_12_months",
        "development_needed"
      ]
    },
    "forecastConfidence": {
      "type": "number",
      "default": 0
    },
    "successionRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidenceStrength": {
      "type": "number",
      "default": 0
    },
    "leadershipSimulationsPassed": {
      "type": "number",
      "default": 0
    },
    "strategicJudgmentScore": {
      "type": "number",
      "default": 0
    },
    "executiveCommunicationScore": {
      "type": "number",
      "default": 0
    },
    "recommendedDevelopmentActions": {
      "type": "object",
      "additionalProperties": true
    },
    "lastCalibratedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizationId",
    "employeeId",
    "targetRole",
    "promotionForecast"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "chro"
                  }
                },
                {
                  "user_condition": {
                    "role": "talent_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "chro"
                  }
                },
                {
                  "user_condition": {
                    "role": "vp_talent_management"
                  }
                },
                {
                  "user_condition": {
                    "role": "leadership_development_head"
                  }
                },
                {
                  "user_condition": {
                    "role": "talent_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "hrbp"
                  }
                },
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "chro"
                  }
                },
                {
                  "user_condition": {
                    "role": "talent_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}