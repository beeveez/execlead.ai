{
  "name": "InterviewScenario",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scenario_id": {
      "type": "string",
      "description": "Unique scenario ID (IS-NNN)"
    },
    "name": {
      "type": "string",
      "description": "Scenario name (e.g. Raise Seed Funding)"
    },
    "summary": {
      "type": "string",
      "description": "Short description"
    },
    "persona": {
      "type": "string",
      "description": "Interviewer persona (Investor, Enterprise CIO, ...)"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "intermediate"
    },
    "category": {
      "type": "string",
      "description": "Scenario category"
    },
    "question_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked LaunchQuestion IDs"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "scenario_id",
    "name",
    "persona"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}