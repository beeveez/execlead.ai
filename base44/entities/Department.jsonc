{
  "name": "Department",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "head_user_id": {
      "type": "string"
    },
    "head_name": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "organization_id"
  ]
}