{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "failed",
        "refunded"
      ],
      "default": "paid"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "plan": {
      "type": "string"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ]
    }
  },
  "required": [
    "amount",
    "period_start",
    "period_end",
    "owner_user_id"
  ]
}