{
  "name": "KnowledgeRegistryEntry",
  "type": "object",
  "properties": {
    "capability_id": {
      "type": "string"
    },
    "capability_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "private_beta",
        "planned",
        "deprecated",
        "unknown"
      ]
    },
    "workspace": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "knowledge_article_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_article_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "production_route",
        "feature_registry",
        "approved_knowledge",
        "platform_config"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "knowledge_gap",
        "conflict",
        "unverified"
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "current",
        "recent",
        "stale",
        "unknown"
      ]
    },
    "last_verified": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "version": {
      "type": "string"
    },
    "related_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_gap": {
      "type": "boolean",
      "default": false
    },
    "discrepancy_note": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "capability_id",
    "capability_name",
    "status",
    "verification_status",
    "last_verified"
  ]
}