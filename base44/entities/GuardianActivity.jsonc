{
  "name": "GuardianActivity",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scan_id": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "startup",
        "interval",
        "deployment",
        "feature_update",
        "navigation_change",
        "manual"
      ],
      "default": "startup"
    },
    "category": {
      "type": "string",
      "enum": [
        "route",
        "navigation",
        "permission",
        "feature",
        "plan",
        "api",
        "role",
        "organization"
      ],
      "default": "feature"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "information"
      ],
      "default": "warning"
    },
    "issue": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "auto",
        "queued",
        "alert",
        "manual",
        "rollback"
      ],
      "default": "auto"
    },
    "confidence_score": {
      "type": "number",
      "default": 0
    },
    "result": {
      "type": "string",
      "enum": [
        "applied",
        "queued",
        "alerted",
        "failed",
        "rolled_back",
        "skipped"
      ],
      "default": "applied"
    },
    "rollback_status": {
      "type": "string",
      "enum": [
        "none",
        "available",
        "rolled_back",
        "not_reversible"
      ],
      "default": "none"
    },
    "snapshot_json": {
      "type": "string"
    },
    "action_json": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "issue",
    "action_taken"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "platform_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}