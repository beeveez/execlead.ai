{
  "name": "NetworkEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "roundtable",
        "summit",
        "masterclass",
        "webinar",
        "fireside_chat",
        "networking",
        "workshop",
        "ama",
        "ai_briefing",
        "boardroom",
        "product_demo",
        "founder_meetup",
        "investor_pitch",
        "community_meetup",
        "retreat",
        "ai_strategy",
        "career_accelerator"
      ],
      "default": "roundtable"
    },
    "cover_image_url": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "is_virtual": {
      "type": "boolean",
      "default": true
    },
    "meeting_url": {
      "type": "string"
    },
    "meeting_platform": {
      "type": "string",
      "enum": [
        "zoom",
        "teams",
        "meet",
        "webrtc",
        "other"
      ],
      "default": "zoom"
    },
    "location": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "venue_address": {
      "type": "string"
    },
    "venue_maps_url": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "default": 0
    },
    "max_capacity": {
      "type": "number",
      "default": 0
    },
    "registered_count": {
      "type": "number",
      "default": 0
    },
    "waitlist_count": {
      "type": "number",
      "default": 0
    },
    "attended_count": {
      "type": "number",
      "default": 0
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "agenda_json": {
      "type": "string",
      "description": "JSON array of {time, title, speaker, description}"
    },
    "speakers_json": {
      "type": "string",
      "description": "JSON array of {name, title, company, bio, photo, linkedin, executive_score, verified, topics}"
    },
    "sponsors_json": {
      "type": "string",
      "description": "JSON array of {name, tier, logo, website}"
    },
    "faq_json": {
      "type": "string",
      "description": "JSON array of {question, answer}"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "industry": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "completed",
        "cancelled",
        "draft"
      ],
      "default": "upcoming"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "recording_url": {
      "type": "string"
    },
    "certificate_enabled": {
      "type": "boolean",
      "default": false
    },
    "networking_enabled": {
      "type": "boolean",
      "default": true
    },
    "discussions_enabled": {
      "type": "boolean",
      "default": true
    },
    "organizer_name": {
      "type": "string"
    },
    "organizer_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "host_company": {
      "type": "string"
    },
    "host_photo": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "community_name": {
      "type": "string"
    },
    "rsvp_json": {
      "type": "string"
    },
    "rsvp_count": {
      "type": "number",
      "default": 0
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "event_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}