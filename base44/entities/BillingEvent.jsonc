{
  "name": "BillingEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "event_type": {
      "type": "string",
      "enum": [
        "payment_success",
        "payment_failed",
        "subscription_created",
        "subscription_updated",
        "subscription_canceled",
        "subscription_renewed",
        "subscription_resumed",
        "refund_processed",
        "trial_started",
        "trial_ended",
        "coupon_applied",
        "checkout_completed",
        "cycle_changed",
        "plan_changed",
        "enterprise_request",
        "invoice_access"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending",
        "denied"
      ],
      "default": "success"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "provider": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ]
    },
    "transaction_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}