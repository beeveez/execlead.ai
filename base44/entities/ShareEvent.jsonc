{
  "name": "ShareEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "achievement_type": {
      "type": "string"
    },
    "achievement_title": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "recruiter_visible",
        "organization_only"
      ],
      "default": "public"
    },
    "hide_name": {
      "type": "boolean",
      "default": false
    },
    "hide_score": {
      "type": "boolean",
      "default": false
    },
    "hide_company": {
      "type": "boolean",
      "default": false
    },
    "hide_resume": {
      "type": "boolean",
      "default": false
    },
    "hide_personal_info": {
      "type": "boolean",
      "default": false
    },
    "executive_score": {
      "type": "number"
    },
    "leadership_level": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "share_url": {
      "type": "string"
    },
    "is_enterprise": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "achievement_type",
    "platform"
  ]
}