{
  "name": "AnswerAttempt",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "attempt_id": {
      "type": "string",
      "description": "Unique attempt ID (AA-NNNNNN)"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "question_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "persona": {
      "type": "string",
      "description": "Persona the answer was practiced for"
    },
    "answer": {
      "type": "string",
      "maxLength": 8000,
      "description": "The user's answer"
    },
    "scores_json": {
      "type": "string",
      "description": "JSON of per-dimension scores"
    },
    "feedback": {
      "type": "string",
      "description": "AI coach feedback"
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "word_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "attempt_id",
    "user_id",
    "question"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
