{
  "name": "IdentityVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "trust_level": {
      "type": "number",
      "default": 0,
      "description": "0-5 calculated trust level"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "0-100 calculated trust score"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "email_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "phone_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "phone_number": {
      "type": "string"
    },
    "phone_otp_code": {
      "type": "string",
      "description": "Current OTP code for phone verification"
    },
    "phone_otp_expires": {
      "type": "string",
      "format": "date-time",
      "description": "OTP expiry timestamp"
    },
    "phone_otp_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of failed OTP verification attempts"
    },
    "phone_otp_method": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ],
      "description": "OTP delivery method used"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false
    },
    "identity_verified_date": {
      "type": "string",
      "format": "date"
    },
    "identity_verified_method": {
      "type": "string",
      "enum": [
        "manual_review",
        "ai_assisted",
        "third_party"
      ],
      "default": "manual_review"
    },
    "identity_verified_by": {
      "type": "string",
      "description": "Reviewer name or provider name"
    },
    "identity_document_type": {
      "type": "string",
      "enum": [
        "passport",
        "drivers_license",
        "national_id",
        "government_id",
        "employee_id"
      ]
    },
    "identity_document_uri": {
      "type": "string",
      "description": "Private file URI \u2014 never exposed publicly"
    },
    "identity_status": {
      "type": "string",
      "enum": [
        "pending_upload",
        "submitted",
        "under_review",
        "approved",
        "verified",
        "rejected"
      ],
      "default": "pending_upload"
    },
    "identity_rejection_reason": {
      "type": "string"
    },
    "identity_submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "identity_reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "professional_verified": {
      "type": "boolean",
      "default": false
    },
    "professional_verified_date": {
      "type": "string",
      "format": "date"
    },
    "professional_verified_method": {
      "type": "string",
      "enum": [
        "corporate_email",
        "company_invitation",
        "enterprise_admin",
        "linkedin"
      ],
      "default": "corporate_email"
    },
    "professional_verified_by": {
      "type": "string",
      "description": "Organization name or verifier"
    },
    "organization_verified": {
      "type": "boolean",
      "default": false
    },
    "organization_verified_date": {
      "type": "string",
      "format": "date"
    },
    "organization_verified_method": {
      "type": "string",
      "enum": [
        "domain_verification",
        "enterprise_admin",
        "duns_lookup",
        "manual_review"
      ],
      "default": "domain_verification"
    },
    "organization_verified_by": {
      "type": "string"
    },
    "education_verified": {
      "type": "boolean",
      "default": false
    },
    "education_verified_date": {
      "type": "string",
      "format": "date"
    },
    "education_verified_method": {
      "type": "string",
      "enum": [
        "credential_check",
        "institution_verification",
        "manual_review",
        "third_party"
      ],
      "default": "credential_check"
    },
    "education_verified_by": {
      "type": "string",
      "description": "Institution name or verifier"
    },
    "executive_credentials_verified": {
      "type": "boolean",
      "default": false
    },
    "executive_credentials_verified_date": {
      "type": "string",
      "format": "date"
    },
    "executive_portfolio_verified": {
      "type": "boolean",
      "default": false
    },
    "executive_portfolio_verified_date": {
      "type": "string",
      "format": "date"
    },
    "resume_verified": {
      "type": "boolean",
      "default": false
    },
    "resume_verified_date": {
      "type": "string",
      "format": "date"
    },
    "leadership_dna_complete": {
      "type": "boolean",
      "default": false
    },
    "leadership_dna_date": {
      "type": "string",
      "format": "date"
    },
    "profile_published": {
      "type": "boolean",
      "default": false
    },
    "profile_published_date": {
      "type": "string",
      "format": "date-time"
    },
    "verified_executive": {
      "type": "boolean",
      "default": false
    },
    "verified_executive_date": {
      "type": "string",
      "format": "date"
    },
    "founding_member": {
      "type": "boolean",
      "default": false
    },
    "founding_member_number": {
      "type": "string"
    },
    "founding_member_since": {
      "type": "string",
      "format": "date"
    },
    "organization_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "verification_provider": {
      "type": "string",
      "enum": [
        "none",
        "stripe_identity",
        "persona",
        "onfido",
        "veriff",
        "sumsub",
        "linkedin",
        "microsoft_entra",
        "google_workspace",
        "okta"
      ],
      "default": "none"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low",
      "description": "Current risk-based verification level"
    },
    "risk_flags_json": {
      "type": "string",
      "description": "JSON array of active risk flags"
    },
    "last_risk_assessment": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "workflow_stages_json": {
      "type": "string",
      "description": "JSON object mapping category keys to workflow stage objects { category: { stage, entered_date, completed_date } }"
    },
    "expiration_config_json": {
      "type": "string",
      "description": "JSON object mapping category keys to expiration config { category: { type: 'never'|'annual'|'24_months'|'custom', custom_months, expiration_date, last_renewed_date } }"
    },
    "confidence_verification_quality": {
      "type": "number",
      "default": 0,
      "description": "0-100 quality score based on verification methods used"
    },
    "confidence_evidence_quality": {
      "type": "number",
      "default": 0,
      "description": "0-100 quality score based on evidence items"
    },
    "confidence_coverage": {
      "type": "number",
      "default": 0,
      "description": "0-100 score based on verification categories complete"
    },
    "confidence_document_quality": {
      "type": "number",
      "default": 0,
      "description": "0-100 score based on document types and quality"
    },
    "confidence_review_quality": {
      "type": "number",
      "default": 0,
      "description": "0-100 score based on reviewer credentials"
    },
    "confidence_overall": {
      "type": "number",
      "default": 0,
      "description": "0-100 weighted overall identity confidence"
    },
    "confidence_calculated_date": {
      "type": "string",
      "format": "date-time"
    },
    "executive_role_verified": {
      "type": "boolean",
      "default": false,
      "description": "Executive role verified by enterprise admin"
    },
    "executive_role_verified_date": {
      "type": "string",
      "format": "date"
    },
    "executive_role_verified_by": {
      "type": "string",
      "description": "Enterprise admin who verified"
    },
    "executive_role_verified_method": {
      "type": "string",
      "enum": [
        "enterprise_admin",
        "hr_confirmation",
        "board_resolution",
        "org_chart"
      ],
      "default": "enterprise_admin"
    },
    "internal_credentials_verified": {
      "type": "boolean",
      "default": false,
      "description": "Internal credentials verified by enterprise admin"
    },
    "internal_credentials_verified_date": {
      "type": "string",
      "format": "date"
    },
    "internal_credentials_verified_by": {
      "type": "string",
      "description": "Enterprise admin who verified"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}