{
  "name": "CompetitiveEvidence",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "evidence_id": {
      "type": "string",
      "description": "Unique evidence ID (EV-NNNN)"
    },
    "competitor": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "description": "Feature key the evidence supports"
    },
    "statement": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "public_website",
        "public_documentation",
        "public_pricing",
        "press_release",
        "security_documentation",
        "product_documentation",
        "analyst_report",
        "public_interview",
        "release_notes",
        "public_demo",
        "pricing_page"
      ],
      "default": "public_website"
    },
    "source": {
      "type": "string"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "default": "Medium"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "pending_review",
        "outdated",
        "archived"
      ],
      "default": "pending_review"
    }
  },
  "required": [
    "competitor",
    "capability",
    "statement"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}