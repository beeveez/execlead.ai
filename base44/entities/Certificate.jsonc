{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "certificate_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "course_name": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "verification_url": {
      "type": "string"
    }
  },
  "required": [
    "certificate_id",
    "course_id",
    "course_name",
    "user_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}