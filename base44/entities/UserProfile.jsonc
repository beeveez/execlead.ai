{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string"
    },
    "mobile_number": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "professional_headline": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "current_role": {
      "type": "string"
    },
    "career_stage": {
      "type": "string",
      "description": "Where the user is in their leadership journey"
    },
    "current_company": {
      "type": "string"
    },
    "target_company": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "target_country": {
      "type": "string"
    },
    "expected_salary": {
      "type": "number"
    },
    "preferred_industry": {
      "type": "string"
    },
    "work_preference": {
      "type": "string",
      "description": "JSON array of work preferences or legacy single value"
    },
    "salary_currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency for expected salary"
    },
    "career_intelligence_json": {
      "type": "string",
      "description": "JSON: Career Intelligence Profile\u2122 from Master Registries"
    },
    "linkedin_url": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "portfolio_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "resume_url": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_json": {
      "type": "string"
    },
    "education_json": {
      "type": "string"
    },
    "certifications_json": {
      "type": "string"
    },
    "languages_json": {
      "type": "string"
    },
    "projects_json": {
      "type": "string"
    },
    "awards_json": {
      "type": "string"
    },
    "privacy_profile": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "recruiter_visible"
      ],
      "default": "private"
    },
    "hide_salary": {
      "type": "boolean",
      "default": false
    },
    "hide_resume": {
      "type": "boolean",
      "default": false
    },
    "hide_email": {
      "type": "boolean",
      "default": false
    },
    "leadership_experience": {
      "type": "string"
    },
    "certifications": {
      "type": "string"
    },
    "career_goals": {
      "type": "string"
    },
    "preferred_learning_style": {
      "type": "string"
    },
    "growth_plan": {
      "type": "string"
    },
    "ai_personality": {
      "type": "string",
      "default": "executive_mentor"
    },
    "interview_readiness": {
      "type": "number",
      "default": 0
    },
    "promotion_readiness": {
      "type": "number",
      "default": 0
    },
    "leadership_maturity": {
      "type": "number",
      "default": 0
    },
    "commercial_maturity": {
      "type": "number",
      "default": 0
    },
    "communication_growth": {
      "type": "number",
      "default": 0
    },
    "executive_presence": {
      "type": "number",
      "default": 0
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "challenges_completed": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_active_date": {
      "type": "string",
      "format": "date"
    },
    "weak_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strong_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "organization_id": {
      "type": "string"
    },
    "custom_role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "subscription_plan": {
      "type": "string",
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "default": "active"
    },
    "subscription_cycle": {
      "type": "string",
      "default": "monthly"
    },
    "public_username": {
      "type": "string"
    },
    "public_profile_enabled": {
      "type": "boolean",
      "default": false
    },
    "public_visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "organization",
        "private"
      ],
      "default": "private"
    },
    "public_content_json": {
      "type": "string"
    },
    "public_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_profile_archived": {
      "type": "boolean",
      "default": false
    },
    "public_hide_email": {
      "type": "boolean",
      "default": true
    },
    "public_hide_phone": {
      "type": "boolean",
      "default": true
    },
    "public_hide_address": {
      "type": "boolean",
      "default": true
    },
    "public_hide_salary": {
      "type": "boolean",
      "default": true
    },
    "public_hide_notes": {
      "type": "boolean",
      "default": true
    },
    "allow_search_indexing": {
      "type": "boolean",
      "default": false
    },
    "verified_executive": {
      "type": "boolean",
      "default": false
    },
    "founding_member": {
      "type": "boolean",
      "default": false
    },
    "founding_member_since": {
      "type": "string",
      "format": "date-time"
    },
    "trust_score": {
      "type": "number",
      "default": 40,
      "description": "Community Trust Score 0-100"
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "restricted",
        "limited",
        "good",
        "very_good",
        "excellent"
      ],
      "default": "limited"
    },
    "trust_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "community_standards_accepted": {
      "type": "boolean",
      "default": false
    },
    "community_standards_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false
    },
    "commenting_suspended_until": {
      "type": "string",
      "format": "date-time",
      "description": "Temporary commenting mute/suspension expiry"
    },
    "account_banned": {
      "type": "boolean",
      "default": false,
      "description": "Permanent account ban"
    },
    "cached_journey_points": {
      "type": "number",
      "default": 0,
      "description": "Cached total Journey Points"
    },
    "cached_journey_level_id": {
      "type": "string",
      "description": "Cached Journey Level ID (queryable)"
    },
    "cached_readiness_score": {
      "type": "number",
      "default": 0,
      "description": "Cached Executive Readiness 0-100 (queryable)"
    },
    "cached_trust_score": {
      "type": "number",
      "default": 0,
      "description": "Cached Executive Trust Score 0-100 (queryable)"
    },
    "cached_trust_tier": {
      "type": "string",
      "description": "Cached Trust Tier (queryable)"
    },
    "cached_promotion_probability": {
      "type": "number",
      "default": 0,
      "description": "Cached Promotion Forecast probability 0-100 (queryable)"
    },
    "cached_promotion_timeline_low": {
      "type": "number",
      "default": 0
    },
    "cached_promotion_timeline_high": {
      "type": "number",
      "default": 0
    },
    "cached_promotion_confidence": {
      "type": "string"
    },
    "cached_intelligence_json": {
      "type": "string",
      "description": "Full computed intelligence result (journey+readiness+trust+forecast+timeline+achievements+streaks+digest)"
    },
    "intelligence_computed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When intelligence was last computed"
    },
    "intelligence_config_version": {
      "type": "string",
      "description": "Config version used for last computation (for cache invalidation)"
    },
    "intelligence_warnings_json": {
      "type": "string",
      "description": "Warnings from last computation"
    },
    "intelligence_recompute_count": {
      "type": "number",
      "default": 0,
      "description": "How many times intelligence has been recomputed"
    },
    "intelligence_compute_duration_ms": {
      "type": "number",
      "default": 0,
      "description": "Duration of last computation in milliseconds"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}