{
  "name": "VerificationLog",
  "type": "object",
  "properties": {
    "verification_id": {
      "type": "string",
      "description": "Linked IdentityVerification record ID"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "verification_requested",
        "identity_submitted",
        "identity_approved",
        "identity_rejected",
        "identity_updated",
        "email_verified",
        "phone_verified",
        "otp_sent",
        "otp_verified",
        "otp_failed",
        "professional_verified",
        "employment_approved",
        "organization_approved",
        "education_verified",
        "executive_credentials_verified",
        "executive_portfolio_verified",
        "profile_published",
        "resume_verified",
        "leadership_dna_complete",
        "verified_executive_granted",
        "verification_revoked",
        "device_trusted",
        "device_revoked",
        "risk_challenge_triggered",
        "documents_requested"
      ],
      "default": "verification_requested"
    },
    "document_type": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "pending"
      ],
      "default": "pending"
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ip_address": {
      "type": "string",
      "description": "Masked IP address"
    },
    "device_fingerprint": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    }
  },
  "required": [
    "verification_id",
    "action"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}