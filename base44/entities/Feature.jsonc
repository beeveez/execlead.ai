{
  "name": "Feature",
  "type": "object",
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "minimum_plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "executive",
        "enterprise"
      ],
      "default": "free"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "limit_label": {
      "type": "string"
    }
  },
  "required": [
    "feature_id",
    "name"
  ]
}