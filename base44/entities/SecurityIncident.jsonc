{
  "name": "SecurityIncident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "contained",
        "resolved",
        "postmortem"
      ],
      "default": "open"
    },
    "category": {
      "type": "string",
      "enum": [
        "unauthorized_access",
        "data_breach",
        "malware",
        "phishing",
        "credential_stuffing",
        "privilege_escalation",
        "api_abuse",
        "identity_fraud",
        "payment_fraud",
        "other"
      ],
      "default": "other"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "evidence_json": {
      "type": "string"
    },
    "timeline_json": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "postmortem": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time"
    },
    "affected_users": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "severity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "platform_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}