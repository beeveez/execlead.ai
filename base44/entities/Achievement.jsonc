{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "achievement_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "xp_reward": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "challenge",
        "streak",
        "simulation",
        "debate",
        "learning",
        "level",
        "score"
      ]
    }
  },
  "required": [
    "achievement_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}