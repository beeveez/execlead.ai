{
  "name": "EnterpriseIntegration",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "integration_key": {
      "type": "string",
      "description": "Stable unique key (google_drive, microsoft_365, azure_ad, slack, microsoft_teams, airtable, workday, sap_successfactors, bamboohr, greenhouse)"
    },
    "display_name": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "phase_1",
        "phase_2"
      ],
      "default": "phase_1"
    },
    "category": {
      "type": "string",
      "enum": [
        "productivity",
        "identity",
        "collaboration",
        "hris",
        "ats",
        "database"
      ],
      "default": "productivity"
    },
    "platform_connector_type": {
      "type": "string",
      "description": "Base44 integration_type when a platform connector exists, else 'custom'"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "available",
        "custom_required",
        "disabled"
      ],
      "default": "available"
    },
    "oauth_scopes": {
      "type": "string",
      "description": "Least-privilege OAuth scopes (comma-separated)"
    },
    "least_privilege_notes": {
      "type": "string",
      "description": "Why these scopes are the minimum required"
    },
    "connection_owner": {
      "type": "string",
      "description": "Accountable owner of the connection"
    },
    "last_used_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "last_synchronized": {
      "type": "string",
      "format": "date-time"
    },
    "enterprise_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enterprise disable switch \u2014 when false the integration is disabled for all workflows"
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "Public",
        "Internal",
        "Confidential",
        "Restricted"
      ],
      "default": "Confidential"
    },
    "compliance_tags": {
      "type": "string",
      "description": "Compliance frameworks (SOC 2, GDPR, HIPAA-eligible, etc.)"
    },
    "last_scope_review": {
      "type": "string",
      "format": "date"
    },
    "scope_review_status": {
      "type": "string",
      "enum": [
        "current",
        "review_due",
        "pending"
      ],
      "default": "pending"
    },
    "audit_log_enabled": {
      "type": "boolean",
      "default": true
    },
    "security_status": {
      "type": "string",
      "enum": [
        "verified",
        "pending_review",
        "not_connected"
      ],
      "default": "pending_review"
    },
    "webhook_supported": {
      "type": "boolean",
      "default": false
    },
    "value_proposition": {
      "type": "string",
      "description": "Executive workflow value this integration unlocks"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "integration_key",
    "display_name",
    "phase"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}