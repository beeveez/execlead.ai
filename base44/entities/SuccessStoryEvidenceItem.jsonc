{
  "name": "SuccessStoryEvidenceItem",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence_item_id": {
      "type": "string",
      "description": "Unique evidence item ID (SSE-NNNNNN)"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "behavioral_action",
        "simulation",
        "reflection"
      ],
      "default": "behavioral_action"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "competency": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "follow_up": {
      "type": "string"
    },
    "signals_json": {
      "type": "string"
    },
    "journey_points": {
      "type": "number",
      "default": 0
    },
    "readiness_score": {
      "type": "number",
      "default": 0
    },
    "target_role": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "anonymous",
        "named"
      ],
      "default": "private"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}