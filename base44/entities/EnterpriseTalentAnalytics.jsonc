{
  "name": "EnterpriseTalentAnalytics",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "cohortId": {
      "type": "string"
    },
    "cohortName": {
      "type": "string"
    },
    "snapshotDate": {
      "type": "string",
      "format": "date-time"
    },
    "invitedCount": {
      "type": "number",
      "default": 0
    },
    "startedCount": {
      "type": "number",
      "default": 0
    },
    "completedCount": {
      "type": "number",
      "default": 0
    },
    "completionRate": {
      "type": "number",
      "default": 0
    },
    "averageReadinessScore": {
      "type": "number",
      "default": 0
    },
    "readinessDistribution": {
      "type": "object",
      "additionalProperties": true
    },
    "highPotentialCount": {
      "type": "number",
      "default": 0
    },
    "promotionReadyCount": {
      "type": "number",
      "default": 0
    },
    "successionBenchStrength": {
      "type": "number",
      "default": 0
    },
    "successionBenchStrengthLabel": {
      "type": "string",
      "default": "Developing"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizationId",
    "cohortName",
    "snapshotDate"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}