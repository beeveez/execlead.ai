{
  "name": "CPQSupportPackage",
  "type": "object",
  "properties": {
    "package_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "response_sla_hours": {
      "type": "number",
      "default": 48
    },
    "dedicated_csm": {
      "type": "boolean",
      "default": false
    },
    "technical_account_manager": {
      "type": "boolean",
      "default": false
    },
    "support_24x7": {
      "type": "boolean",
      "default": false
    },
    "monthly_price": {
      "type": "number",
      "default": 0
    },
    "annual_price": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "package_id",
    "name"
  ]
}