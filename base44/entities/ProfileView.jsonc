{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "owner_username": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "direct",
        "qr",
        "linkedin",
        "share",
        "search",
        "other"
      ],
      "default": "direct"
    },
    "viewer_referrer": {
      "type": "string"
    },
    "viewer_timezone": {
      "type": "string"
    }
  },
  "required": [
    "owner_username"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}