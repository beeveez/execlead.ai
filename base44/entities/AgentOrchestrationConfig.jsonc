{
  "name": "AgentOrchestrationConfig",
  "type": "object",
  "properties": {
    "config_id": {
      "type": "string",
      "description": "Unique configuration record identifier. Single authoritative record: 'agent_orchestration_global'"
    },
    "stop_new_executions": {
      "type": "boolean",
      "default": false,
      "description": "Emergency kill switch \u2014 when true, the Agent Orchestration Service blocks every new Workforce execution before any tool runs. If the config record is missing, the orchestrator fails closed (treated as stopped)"
    },
    "max_risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low",
      "description": "Maximum registered tool risk_level permitted for Workforce execution. Phase 5 permits low only"
    },
    "updated_by": {
      "type": "string",
      "description": "User id of the last operator who changed this emergency configuration"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this configuration was last changed"
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Operational reason for the last change (emergency incident reference, drill, etc.)"
    }
  },
  "required": [
    "config_id",
    "stop_new_executions",
    "max_risk_level"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}