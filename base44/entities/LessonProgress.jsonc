{
  "name": "LessonProgress",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization this learning record belongs to"
    },
    "manager_id": {
      "type": "string",
      "description": "Assigned manager (role-aware read access)"
    },
    "coach_id": {
      "type": "string",
      "description": "Assigned executive coach (role-aware read access)"
    },
    "lesson_id": {
      "type": "string"
    },
    "lesson_title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "bookmarked": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "Owner-editable personal notes"
    },
    "reflection": {
      "type": "string",
      "description": "Owner-editable reflection journal"
    },
    "feedback": {
      "type": "string",
      "description": "Owner-editable lesson feedback"
    },
    "quiz_score": {
      "type": "number",
      "default": 0,
      "description": "System-controlled \u2014 updated by Quiz Engine\u2122 only"
    },
    "time_spent_minutes": {
      "type": "number",
      "default": 0,
      "description": "System-controlled \u2014 updated by Learning Engine\u2122 only"
    },
    "xp_earned": {
      "type": "number",
      "default": 0,
      "description": "System-controlled \u2014 updated by Learning Engine\u2122 only"
    },
    "certification_earned": {
      "type": "boolean",
      "default": false,
      "description": "System-controlled \u2014 updated by Certification Engine\u2122 only"
    },
    "competency_gain": {
      "type": "number",
      "default": 0,
      "description": "System-controlled \u2014 updated by Learning Engine\u2122 only"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "System-controlled \u2014 updated by Learning Engine\u2122 only"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete flag \u2014 platform admin only"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by_id": {
      "type": "string"
    }
  },
  "required": [
    "lesson_id",
    "lesson_title",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.manager_id": "{{user.id}}"
        },
        {
          "data.coach_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}