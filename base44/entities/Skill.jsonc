{
  "name": "Skill",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "skill_name": {
      "type": "string",
      "description": "Name of the skill"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "leadership",
        "business",
        "ai_digital"
      ],
      "default": "technical",
      "description": "Legacy category grouping"
    },
    "capability_domain": {
      "type": "string",
      "enum": [
        "technology",
        "leadership",
        "strategy",
        "operations",
        "governance",
        "finance",
        "communication",
        "people_leadership",
        "transformation",
        "innovation",
        "risk",
        "customer_success"
      ],
      "default": "technology",
      "description": "Executive Capability Domain™"
    },
    "proficiency": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "intermediate",
      "description": "Proficiency level"
    },
    "years_of_experience": {
      "type": "number",
      "default": 0,
      "description": "Years of experience with this skill"
    },
    "last_used": {
      "type": "string",
      "description": "When the skill was last used"
    },
    "acquired_year": {
      "type": "number",
      "description": "Year the skill was first acquired (for timeline)"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the skill has been verified"
    },
    "verification_source": {
      "type": "string",
      "description": "How the skill was verified"
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "self_reported",
        "ai_detected",
        "resume_verified",
        "experience_verified",
        "certification_verified",
        "manager_verified",
        "peer_verified",
        "enterprise_verified"
      ],
      "default": "self_reported",
      "description": "Verification Engine™ state"
    },
    "confidence_score": {
      "type": "number",
      "default": 0,
      "description": "Skill Confidence Score™ 0-100"
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "low",
      "description": "Confidence level bucket"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "growing",
        "emerging",
        "needs_refresh",
        "legacy",
        "deprecated"
      ],
      "default": "healthy",
      "description": "Executive Skill Health™ status"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "resume",
        "linkedin",
        "ai_suggested",
        "work_experience",
        "certification"
      ],
      "default": "manual",
      "description": "Where the skill was sourced from"
    },
    "market_demand": {
      "type": "string",
      "enum": [
        "high_demand",
        "growing",
        "emerging",
        "stable",
        "declining",
        "legacy"
      ],
      "default": "stable",
      "description": "Market Intelligence™ demand level"
    },
    "evidence_json": {
      "type": "string",
      "description": "JSON array of { source, type, description, confidence_weight }"
    },
    "related_skills_json": {
      "type": "string",
      "description": "JSON array of related skill names for Executive Skill Graph™"
    },
    "change_history_json": {
      "type": "string",
      "description": "JSON array of { timestamp, event, details } — immutable audit trail"
    },
    "skill_impact_json": {
      "type": "string",
      "description": "JSON object of Executive Skill Impact™ — contribution to each module"
    },
    "recommendation_reason": {
      "type": "string",
      "description": "AI explanation for why this skill is recommended"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    }
  },
  "required": [
    "skill_name",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
