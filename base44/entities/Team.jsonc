{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string",
      "description": "Parent department"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "manager_user_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "capacity": {
      "type": "number",
      "default": 10,
      "description": "Max team size"
    },
    "is_cross_functional": {
      "type": "boolean",
      "default": false,
      "description": "Cross-functional team spanning multiple departments"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "organization_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}