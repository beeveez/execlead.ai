{
  "name": "MembershipProgram",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "founding_member",
        "beta_tester",
        "ambassador",
        "partner",
        "internal_staff",
        "advisory_council",
        "custom"
      ],
      "default": "custom"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "campaign_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "campaign_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "max_participants": {
      "type": "number",
      "default": 0
    },
    "benefit_duration_type": {
      "type": "string",
      "enum": [
        "lifetime",
        "time_limited"
      ],
      "default": "lifetime"
    },
    "benefit_duration_days": {
      "type": "number",
      "default": 0
    },
    "discount_percentage": {
      "type": "number",
      "default": 0
    },
    "lifetime_pricing_protection": {
      "type": "boolean",
      "default": false
    },
    "exclusive_badge": {
      "type": "string"
    },
    "badge_color": {
      "type": "string",
      "default": "#f59e0b"
    },
    "community_access": {
      "type": "boolean",
      "default": false
    },
    "early_feature_access": {
      "type": "boolean",
      "default": false
    },
    "roadmap_voting": {
      "type": "boolean",
      "default": false
    },
    "feedback_sessions": {
      "type": "boolean",
      "default": false
    },
    "referral_bonus_enabled": {
      "type": "boolean",
      "default": false
    },
    "referral_bonus_amount": {
      "type": "number",
      "default": 0
    },
    "membership_number_prefix": {
      "type": "string"
    },
    "next_sequence": {
      "type": "number",
      "default": 1
    },
    "icon": {
      "type": "string",
      "default": "\ud83c\udfc6"
    },
    "color": {
      "type": "string",
      "default": "#f59e0b"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "enrolled_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "program_type",
    "membership_number_prefix"
  ]
}