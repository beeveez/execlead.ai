{
  "name": "DMAIC Root Cause Approval",
  "description": "Advances projects when a root-cause analysis is approved.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"approvalStatus\") != null) and (.trigger.data.approvalStatus == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "RootCauseAnalysis"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dmaic_root_cause_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageOperationalExcellence",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "manageOperationalExcellence"
  }
}