{
  "name": "GovernanceConfig",
  "type": "object",
  "properties": {
    "founder_user_id": {
      "type": "string",
      "description": "User ID of the Founder Root Administrator"
    },
    "founder_email": {
      "type": "string",
      "description": "Founder email for notifications (reference only — all checks use founder_user_id)"
    },
    "founder_name": {
      "type": "string"
    },
    "founder_role_name": {
      "type": "string",
      "default": "Founder Root Administrator"
    },
    "initialized": {
      "type": "boolean",
      "default": false
    },
    "violation_threshold": {
      "type": "number",
      "default": 3,
      "description": "Auto-notify founder after this many unauthorized attempts"
    },
    "request_expiry_hours": {
      "type": "number",
      "default": 72
    },
    "email_notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "founder_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}
