{
  "name": "EnterpriseROICalculation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "organization_name": {
      "type": "string",
      "description": "Organization evaluated"
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "calc_date": {
      "type": "string",
      "format": "date-time"
    },
    "inputs_json": {
      "type": "string",
      "description": "JSON of customer inputs (Steps 1-3)"
    },
    "assumptions_json": {
      "type": "string",
      "description": "JSON of configurable assumptions (Step 4)"
    },
    "estimated_annual_value": {
      "type": "number",
      "default": 0
    },
    "estimated_three_year_roi": {
      "type": "number"
    },
    "estimated_net_impact": {
      "type": "number",
      "default": 0
    },
    "business_case_generated": {
      "type": "boolean",
      "default": false
    },
    "proposal_generated": {
      "type": "boolean",
      "default": false
    },
    "sales_owner": {
      "type": "string",
      "description": "Sales owner name/email"
    },
    "opportunity_stage": {
      "type": "string",
      "description": "CRM opportunity stage"
    },
    "share_token": {
      "type": "string",
      "description": "Token for sharing the ROI report"
    }
  },
  "required": [
    "organization_name",
    "calc_date"
  ],
  "rls": {
    "create": {
      "data.created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}