{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "executive",
        "enterprise"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "default": "active"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "seats": {
      "type": "number",
      "default": 1
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "google",
        "apple",
        "microsoft",
        "none"
      ],
      "default": "none"
    },
    "customer_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "plan"
  ]
}