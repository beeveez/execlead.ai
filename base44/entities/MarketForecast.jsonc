{
  "name": "MarketForecast",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scenario_name": {
      "type": "string",
      "description": "Name of the forecast scenario"
    },
    "forecast_area": {
      "type": "string",
      "enum": [
        "Executive Assessments",
        "AI Executive Coaching",
        "Enterprise Governance",
        "Responsible AI",
        "Executive Analytics",
        "Leadership Simulations",
        "Executive Identity",
        "Succession Intelligence",
        "Enterprise HR Technology",
        "Market Consolidation"
      ],
      "default": "Executive Assessments"
    },
    "scenario_type": {
      "type": "string",
      "enum": [
        "Baseline",
        "Optimistic",
        "Pessimistic",
        "Alternative"
      ],
      "default": "Baseline"
    },
    "assumption": {
      "type": "string",
      "description": "Key assumption underpinning the scenario"
    },
    "summary": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "default": "Medium"
    },
    "time_horizon": {
      "type": "string",
      "description": "e.g. 12 months, 2-3 years"
    },
    "evidence_summary": {
      "type": "string",
      "description": "Verified signals supporting this scenario"
    },
    "generated_by": {
      "type": "string",
      "default": "AI Scenario Engine"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "scenario_name",
    "forecast_area"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}