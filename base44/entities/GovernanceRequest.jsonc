{
  "name": "GovernanceRequest",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "request_id": {
      "type": "string",
      "description": "Unique governance request ID"
    },
    "requester_id": {
      "type": "string",
      "description": "User who submitted the request"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "requester_role": {
      "type": "string"
    },
    "requester_department": {
      "type": "string"
    },
    "requester_workspace": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "edit_profile",
        "delete_profile",
        "restore_profile",
        "create_administrator",
        "remove_administrator",
        "promote_user",
        "demote_user",
        "modify_permissions",
        "change_security_policies",
        "change_platform_settings",
        "configure_ai_services",
        "configure_developer_workspace",
        "configure_operations_workspace",
        "configure_enterprise_workspace",
        "configure_executive_workspace",
        "export_user_information",
        "view_audit_history"
      ],
      "description": "The protected operation being requested"
    },
    "target_user_id": {
      "type": "string"
    },
    "target_user_name": {
      "type": "string"
    },
    "target_user_email": {
      "type": "string"
    },
    "target_user_role": {
      "type": "string"
    },
    "justification_category": {
      "type": "string",
      "enum": [
        "personnel_change",
        "security_incident",
        "compliance_requirement",
        "organizational_restructure",
        "user_request",
        "data_correction",
        "duplicate_profile_cleanup",
        "test_data_cleanup",
        "platform_configuration",
        "security_configuration",
        "developer_request",
        "operations_request",
        "production_support",
        "emergency_change",
        "system_maintenance",
        "legal_requirement",
        "audit_finding",
        "other"
      ],
      "description": "Standardized business justification category"
    },
    "business_justification": {
      "type": "string",
      "maxLength": 1000,
      "description": "Free-text business justification (min 50, max 1000 characters)"
    },
    "other_explanation": {
      "type": "string",
      "description": "Required when justification_category is 'other'"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "description": "Risk score 0-100"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "impact_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "impact_assessment_json": {
      "type": "string",
      "description": "JSON: { affected_users, affected_modules, affected_workspaces, data_sensitivity, security_risk, operational_risk, business_impact }"
    },
    "current_values_json": {
      "type": "string",
      "description": "JSON of current values before the change"
    },
    "requested_values_json": {
      "type": "string",
      "description": "JSON of requested new values"
    },
    "supporting_evidence": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "revision_requested",
        "info_requested",
        "expired"
      ],
      "default": "pending"
    },
    "approver_id": {
      "type": "string"
    },
    "approver_name": {
      "type": "string"
    },
    "decision_notes": {
      "type": "string",
      "description": "Founder decision notes \u2014 part of permanent audit record"
    },
    "decision_reason": {
      "type": "string",
      "description": "Approval or rejection reason"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_duration_ms": {
      "type": "number",
      "default": 0
    },
    "ip_address": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "expired": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "request_id",
    "requester_id",
    "action",
    "justification_category",
    "business_justification"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}