{
  "name": "EvidenceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Evidence title"
    },
    "category": {
      "type": "string",
      "enum": [
        "award",
        "certificate",
        "government_id",
        "employment_verification",
        "promotion_letter",
        "kpi",
        "performance_review",
        "project_summary",
        "whitepaper",
        "publication",
        "patent",
        "speaking_engagement",
        "board_appointment",
        "recommendation_letter",
        "client_testimonial",
        "leadership_photo",
        "video",
        "presentation"
      ],
      "default": "certificate",
      "description": "Type of evidence"
    },
    "organization": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "string",
      "description": "JSON array of tags"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "recruiters_only",
        "enterprise_only",
        "public"
      ],
      "default": "private"
    },
    "evidence_file_url": {
      "type": "string",
      "description": "URL to uploaded evidence file"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "verifier": {
      "type": "string"
    },
    "verification_date": {
      "type": "string",
      "format": "date-time"
    },
    "related_competencies": {
      "type": "string",
      "description": "JSON array of competency IDs"
    },
    "related_achievements": {
      "type": "string",
      "description": "JSON array of achievement IDs"
    },
    "encryption_status": {
      "type": "string",
      "enum": [
        "encrypted",
        "not_encrypted"
      ],
      "default": "encrypted"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}