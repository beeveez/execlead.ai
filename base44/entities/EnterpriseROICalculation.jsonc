{
  "name": "EnterpriseROICalculation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "organization_name": {
      "type": "string",
      "description": "Organization evaluated"
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "enterprise_size": {
      "type": "number",
      "default": 0,
      "description": "Leadership population size"
    },
    "calc_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time"
    },
    "inputs_json": {
      "type": "string",
      "description": "JSON of customer inputs"
    },
    "assumptions_json": {
      "type": "string",
      "description": "JSON of configurable assumptions"
    },
    "estimated_annual_value": {
      "type": "number",
      "default": 0
    },
    "estimated_three_year_roi": {
      "type": "number"
    },
    "estimated_net_impact": {
      "type": "number",
      "default": 0
    },
    "business_case_generated": {
      "type": "boolean",
      "default": false
    },
    "proposal_generated": {
      "type": "boolean",
      "default": false
    },
    "procurement_package_generated": {
      "type": "boolean",
      "default": false
    },
    "presentation_generated": {
      "type": "boolean",
      "default": false
    },
    "roi_version": {
      "type": "string",
      "default": "2.0"
    },
    "commercial_version": {
      "type": "string",
      "default": "1.0"
    },
    "scenario": {
      "type": "string",
      "description": "Scenario label used"
    },
    "sales_stage": {
      "type": "string",
      "description": "CRM opportunity/sales stage"
    },
    "sales_owner": {
      "type": "string",
      "description": "Sales owner name/email"
    },
    "owner": {
      "type": "string",
      "description": "Account owner"
    },
    "executive_sponsor": {
      "type": "string"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date"
    },
    "win_probability": {
      "type": "number",
      "default": 0
    },
    "annual_contract_value": {
      "type": "number",
      "default": 0
    },
    "lifetime_value": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "share_token": {
      "type": "string"
    }
  },
  "required": [
    "organization_name",
    "calc_date"
  ],
  "rls": {
    "create": {
      "data.created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}