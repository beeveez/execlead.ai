{
  "name": "EvidenceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Evidence title"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "identity",
        "employment",
        "education",
        "certifications",
        "executive_credentials",
        "awards",
        "memberships",
        "publications",
        "projects",
        "patents",
        "board_memberships",
        "licenses",
        "security_clearances",
        "organization_verification",
        "executive_portfolio",
        "award",
        "certificate",
        "government_id",
        "employment_verification",
        "promotion_letter",
        "kpi",
        "performance_review",
        "project_summary",
        "whitepaper",
        "speaking_engagement",
        "board_appointment",
        "recommendation_letter",
        "client_testimonial",
        "leadership_photo",
        "video",
        "presentation"
      ],
      "default": "certificate",
      "description": "Type of evidence — the 15 canonical types plus legacy categories"
    },
    "category": {
      "type": "string",
      "description": "Legacy category field for backward compatibility"
    },
    "organization": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date evidence was issued or occurred"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "string",
      "description": "JSON array of tags"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "recruiters_only",
        "enterprise_only",
        "public"
      ],
      "default": "private"
    },
    "evidence_file_url": {
      "type": "string",
      "description": "URL to uploaded evidence file"
    },
    "evidence_hash": {
      "type": "string",
      "description": "Digital hash for immutability verification"
    },
    "source": {
      "type": "string",
      "description": "Source of the evidence — issuer, provider, or self-reported"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official_document",
        "third_party_verification",
        "self_reported",
        "ai_extracted",
        "manual_review",
        "enterprise_admin",
        "automated_check"
      ],
      "default": "self_reported"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected",
        "expired",
        "revoked"
      ],
      "default": "unverified"
    },
    "verifier": {
      "type": "string"
    },
    "verification_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string",
      "description": "ID of the reviewer who verified this evidence"
    },
    "reviewer_name": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "default": 0,
      "description": "Confidence score 0-100 — how reliable the evidence source is"
    },
    "evidence_quality": {
      "type": "number",
      "default": 0,
      "description": "Evidence Quality Score 0-100 — document quality, completeness"
    },
    "authenticity": {
      "type": "number",
      "default": 0,
      "description": "Authenticity score 0-100 — likelihood the evidence is genuine"
    },
    "freshness": {
      "type": "number",
      "default": 0,
      "description": "Freshness score 0-100 — how current the evidence is"
    },
    "overall_quality": {
      "type": "number",
      "default": 0,
      "description": "Overall Evidence Quality Score 0-100 — weighted composite"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "When this evidence expires (null = permanent)"
    },
    "expiration_type": {
      "type": "string",
      "enum": [
        "never",
        "annual",
        "biennial",
        "custom"
      ],
      "default": "never"
    },
    "related_modules": {
      "type": "string",
      "description": "JSON array of related module names (Verification Center, Executive Trust, etc.)"
    },
    "audit_references": {
      "type": "string",
      "description": "JSON array of audit log IDs and references"
    },
    "related_verification_id": {
      "type": "string",
      "description": "Linked IdentityVerification record ID"
    },
    "related_evidence_ids": {
      "type": "string",
      "description": "JSON array of related EvidenceItem IDs with relationship types for the graph"
    },
    "ai_review_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "pending",
        "completed",
        "flagged"
      ],
      "default": "not_reviewed"
    },
    "ai_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "ai_review_summary": {
      "type": "string",
      "description": "AI-generated review summary"
    },
    "ai_confidence": {
      "type": "number",
      "default": 0,
      "description": "AI confidence in the evidence 0-100"
    },
    "ai_flags": {
      "type": "string",
      "description": "JSON array of AI flags (e.g. expired_document, blurry_image, mismatch)"
    },
    "is_immutable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this evidence record is immutable — once verified, cannot be edited"
    },
    "encryption_status": {
      "type": "string",
      "enum": [
        "encrypted",
        "not_encrypted"
      ],
      "default": "encrypted"
    },
    "related_competencies": {
      "type": "string",
      "description": "JSON array of competency IDs"
    },
    "related_achievements": {
      "type": "string",
      "description": "JSON array of achievement IDs"
    }
  },
  "required": [
    "title",
    "evidence_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
