{
  "name": "MarketTrend",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "trend_name": {
      "type": "string",
      "description": "Name of the industry / market trend"
    },
    "category": {
      "type": "string",
      "enum": [
        "Leadership Technology",
        "AI Leadership Platforms",
        "Enterprise Learning",
        "Executive Coaching",
        "Talent Intelligence",
        "Executive Assessments",
        "AI Agents",
        "Enterprise HR Technology",
        "Succession Planning",
        "Executive Development"
      ],
      "default": "Leadership Technology"
    },
    "trend_direction": {
      "type": "string",
      "enum": [
        "Rising",
        "Stable",
        "Declining",
        "Emerging"
      ],
      "default": "Rising"
    },
    "growth": {
      "type": "string",
      "description": "Qualitative or quantitative growth signal (e.g. 'Accelerating', 'Moderate')"
    },
    "impact": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "default": "Medium"
    },
    "strategic_relevance": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "High"
    },
    "summary": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "trend_name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}