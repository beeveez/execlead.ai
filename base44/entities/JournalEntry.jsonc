{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "lessons_learned": {
      "type": "string"
    },
    "leadership_wins": {
      "type": "string"
    },
    "mistakes": {
      "type": "string"
    },
    "mood": {
      "type": "string",
      "enum": [
        "inspired",
        "confident",
        "neutral",
        "challenged",
        "frustrated"
      ],
      "default": "neutral"
    }
  },
  "required": [
    "title",
    "reflection"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}