{
  "name": "BetaCohort",
  "type": "object",
  "properties": {
    "cohort_name": {
      "type": "string"
    },
    "cohort_type": {
      "type": "string",
      "enum": [
        "founding_a",
        "founding_b",
        "enterprise",
        "executive",
        "partner"
      ],
      "default": "founding_a",
      "description": "Cohort classification"
    },
    "description": {
      "type": "string"
    },
    "target_size": {
      "type": "number",
      "default": 25
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "forming",
        "active",
        "graduating",
        "graduated",
        "archived"
      ],
      "default": "forming"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "cohort_name",
    "cohort_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}