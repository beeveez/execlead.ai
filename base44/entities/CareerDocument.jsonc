{
  "name": "CareerDocument",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "cover_letter",
        "linkedin",
        "bio",
        "portfolio",
        "achievement"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "subtype": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}