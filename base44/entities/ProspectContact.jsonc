{
  "name": "ProspectContact",
  "type": "object",
  "description": "Phase 14E Verified Prospect Contact Capability. An explicitly governed outreach contact destination for a Prospect. EMAIL only. A contact record authorizes NOTHING on its own: it becomes an authoritative outreach recipient ONLY when it is VERIFIED (an explicit governed human action recorded with verified_by_user_id and verified_at) AND is_primary, and even then it can only be consumed by the Phase 14D recipient resolver inside the governed Gmail delivery boundary \u2014 real delivery remains disabled by the global activation gate. Ownership and tenant boundary are derived server-side; client-supplied owner_user_id/organization_id are never trusted. Contact email is sensitive business/contact data: it must never enter LLM prompts, AgentExecution result summaries, AgentApproval metadata, telemetry, UsageLog, or error messages.",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Unique authoritative contact identifier (single source of truth, issued server-side)"
    },
    "prospect_id": {
      "type": "string",
      "description": "prospect_id of the Prospect this contact belongs to \u2014 server-validated against the requesting owner/tenant before create or read"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "EMAIL"
      ],
      "description": "Contact channel type. EMAIL only in this phase \u2014 no phone, social, or generic CRM contact types exist"
    },
    "contact_value": {
      "type": "string",
      "minLength": 5,
      "maxLength": 320,
      "description": "Normalized email address (trimmed, lowercase, valid syntax, no control characters)"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "REVOKED"
      ],
      "default": "UNVERIFIED",
      "description": "Governed verification state. A contact is created UNVERIFIED; VERIFIED is an explicit governed human action only (never implied by syntactic validity); REVOKED is fail-closed terminal \u2014 a revoked contact can never be re-verified or resolve as a recipient"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "MANUAL",
        "ORGANIZATION_CONFIRMED",
        "OTHER_EXPLICITLY_SUPPORTED_METHOD"
      ],
      "description": "Explicitly supported verification method. The Phase 14E governed verify tool accepts MANUAL and ORGANIZATION_CONFIRMED only; other values are reserved for future separately approved methods"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the contact was verified (recorded by the governed verification operation only)"
    },
    "verified_by_user_id": {
      "type": "string",
      "description": "User id of the human actor who verified the contact (recorded server-side by the governed verification operation only)"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the Prospect's primary contact. At most ONE VERIFIED primary EMAIL contact may exist per Prospect \u2014 enforced server-side; client-supplied values never override server rules"
    },
    "source": {
      "type": "string",
      "maxLength": 120,
      "description": "Truthful creation provenance (e.g. governed_verified_contact_capability)"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owning user \u2014 derived server-side from the authenticated caller; never client-supplied"
    },
    "organization_id": {
      "type": "string",
      "description": "Tenant boundary \u2014 derived server-side from the authenticated caller's organization context; never client-supplied"
    }
  },
  "required": [
    "contact_id",
    "prospect_id",
    "contact_type",
    "contact_value",
    "verification_status",
    "source",
    "owner_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "enterprise_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "organization_owner"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}