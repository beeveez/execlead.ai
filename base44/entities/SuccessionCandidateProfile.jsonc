{
  "name": "SuccessionCandidateProfile",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "cohortId": {
      "type": "string"
    },
    "employeeId": {
      "type": "string"
    },
    "employeeName": {
      "type": "string"
    },
    "currentRole": {
      "type": "string"
    },
    "targetRole": {
      "type": "string"
    },
    "businessUnit": {
      "type": "string"
    },
    "readinessScore": {
      "type": "number",
      "default": 0
    },
    "promotionForecast": {
      "type": "string",
      "enum": [
        "ready_now",
        "ready_6_months",
        "ready_12_months",
        "development_needed"
      ]
    },
    "forecastConfidence": {
      "type": "number",
      "default": 0
    },
    "highPotentialConfidence": {
      "type": "number",
      "default": 0
    },
    "evidenceStrength": {
      "type": "number",
      "default": 0
    },
    "successionRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "strategicJudgmentScore": {
      "type": "number",
      "default": 0
    },
    "executiveCommunicationScore": {
      "type": "number",
      "default": 0
    },
    "missionCompletionRate": {
      "type": "number",
      "default": 0
    },
    "growthVelocity": {
      "type": "number",
      "default": 0
    },
    "competencyGapSeverity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "leadershipSimulationsPassed": {
      "type": "number",
      "default": 0
    },
    "leadershipXp": {
      "type": "number",
      "default": 0
    },
    "recommendedDevelopmentActions": {
      "type": "object",
      "additionalProperties": true
    },
    "lastCalibratedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizationId",
    "employeeName",
    "currentRole",
    "targetRole",
    "promotionForecast"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "enterprise_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}