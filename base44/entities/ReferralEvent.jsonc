{
  "name": "ReferralEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "referral_code": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "link_clicked",
        "landing_viewed",
        "registration_completed",
        "email_verified",
        "subscription_started",
        "subscription_renewed",
        "upgrade",
        "downgrade",
        "cancellation",
        "refund",
        "chargeback"
      ]
    },
    "invitee_email": {
      "type": "string"
    },
    "invitee_user_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "metadata_json": {
      "type": "string"
    }
  },
  "required": [
    "referral_code",
    "event_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}