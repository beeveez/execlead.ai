{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "learning_reminder",
        "daily_challenge",
        "achievement",
        "subscription",
        "renewal",
        "system",
        "social"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ]
}