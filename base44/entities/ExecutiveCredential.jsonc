{
  "name": "ExecutiveCredential",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "credential_key": {
      "type": "string",
      "description": "Unique credential type identifier"
    },
    "credential_name": {
      "type": "string"
    },
    "credential_level": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "distinguished",
        "fellow",
        "master_executive"
      ],
      "description": "Credential tier"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "leadership",
        "learning",
        "career",
        "founder"
      ],
      "description": "Credential category"
    },
    "credential_description": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiration_date": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "default": "EXECLEAD.AI"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "active",
        "expiring",
        "expired",
        "suspended",
        "revoked"
      ],
      "default": "active"
    },
    "credential_number": {
      "type": "string",
      "description": "Unique credential ID"
    },
    "credential_hash": {
      "type": "string",
      "description": "Digital hash for verification"
    },
    "verification_url": {
      "type": "string"
    },
    "portfolio_visibility": {
      "type": "string",
      "enum": [
        "private",
        "recruiters",
        "enterprise",
        "public"
      ],
      "default": "public"
    },
    "evidence_summary": {
      "type": "string",
      "description": "JSON array of evidence types"
    },
    "requirements_met": {
      "type": "string",
      "description": "JSON array of met requirement labels"
    },
    "related_competencies": {
      "type": "string"
    },
    "ai_commentary": {
      "type": "string"
    },
    "renewal_status": {
      "type": "string",
      "enum": [
        "permanent",
        "active",
        "expiring_soon",
        "expired",
        "renewal_required"
      ],
      "default": "permanent"
    },
    "is_permanent": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "credential_key",
    "credential_name",
    "credential_level",
    "credential_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}