{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string"
    },
    "mobile_number": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "professional_headline": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "current_role": {
      "type": "string"
    },
    "current_company": {
      "type": "string"
    },
    "target_company": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "target_country": {
      "type": "string"
    },
    "expected_salary": {
      "type": "number"
    },
    "preferred_industry": {
      "type": "string"
    },
    "work_preference": {
      "type": "string",
      "enum": [
        "remote",
        "hybrid",
        "onsite"
      ]
    },
    "linkedin_url": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "portfolio_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "resume_url": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience_json": {
      "type": "string"
    },
    "education_json": {
      "type": "string"
    },
    "certifications_json": {
      "type": "string"
    },
    "languages_json": {
      "type": "string"
    },
    "projects_json": {
      "type": "string"
    },
    "awards_json": {
      "type": "string"
    },
    "privacy_profile": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "recruiter_visible"
      ],
      "default": "private"
    },
    "hide_salary": {
      "type": "boolean",
      "default": false
    },
    "hide_resume": {
      "type": "boolean",
      "default": false
    },
    "hide_email": {
      "type": "boolean",
      "default": false
    },
    "leadership_experience": {
      "type": "string"
    },
    "certifications": {
      "type": "string"
    },
    "career_goals": {
      "type": "string"
    },
    "preferred_learning_style": {
      "type": "string"
    },
    "growth_plan": {
      "type": "string"
    },
    "ai_personality": {
      "type": "string",
      "default": "executive_mentor"
    },
    "interview_readiness": {
      "type": "number",
      "default": 0
    },
    "promotion_readiness": {
      "type": "number",
      "default": 0
    },
    "leadership_maturity": {
      "type": "number",
      "default": 0
    },
    "commercial_maturity": {
      "type": "number",
      "default": 0
    },
    "communication_growth": {
      "type": "number",
      "default": 0
    },
    "executive_presence": {
      "type": "number",
      "default": 0
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "challenges_completed": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_active_date": {
      "type": "string",
      "format": "date"
    },
    "weak_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strong_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "organization_id": {
      "type": "string"
    },
    "custom_role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "manager_id": {
      "type": "string"
    },
    "manager_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "subscription_plan": {
      "type": "string",
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "default": "active"
    },
    "subscription_cycle": {
      "type": "string",
      "default": "monthly"
    },
    "public_username": {
      "type": "string"
    },
    "public_profile_enabled": {
      "type": "boolean",
      "default": false
    },
    "public_visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "organization",
        "private"
      ],
      "default": "private"
    },
    "public_content_json": {
      "type": "string"
    },
    "public_hide_email": {
      "type": "boolean",
      "default": true
    },
    "public_hide_phone": {
      "type": "boolean",
      "default": true
    },
    "public_hide_address": {
      "type": "boolean",
      "default": true
    },
    "public_hide_salary": {
      "type": "boolean",
      "default": true
    },
    "public_hide_notes": {
      "type": "boolean",
      "default": true
    },
    "allow_search_indexing": {
      "type": "boolean",
      "default": false
    },
    "verified_executive": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "target_company",
    "target_role"
  ]
}