{
  "name": "StrategicPartnerAuditLog",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "auditId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "userId": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "partnerId": {
      "type": "string"
    },
    "entityName": {
      "type": "string"
    },
    "recordId": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "Created",
        "Updated",
        "Stage Changed",
        "Status Changed",
        "Score Changed",
        "Revenue Updated",
        "Agreement Updated",
        "Integration Updated",
        "Objective Completed",
        "Partner Terminated",
        "Deleted"
      ]
    },
    "fieldChanged": {
      "type": "string"
    },
    "oldValue": {
      "type": "string"
    },
    "newValue": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "organizationId",
    "auditId",
    "timestamp",
    "userId",
    "entityName",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "sales"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "sales"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "data.organizationId": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}