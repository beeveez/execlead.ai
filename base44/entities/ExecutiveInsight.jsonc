{
  "name": "ExecutiveInsight",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string",
      "description": "Article title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "category": {
      "type": "string",
      "enum": [
        "leadership",
        "executive_strategy",
        "career_growth",
        "ai_leadership",
        "enterprise_transformation",
        "executive_interviews",
        "digital_leadership"
      ],
      "description": "Content category"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary for cards and SEO"
    },
    "content": {
      "type": "string",
      "description": "Full article body (markdown)"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "author_is_founder": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is founder thought leadership content"
    },
    "featured_image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "featured"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "reading_time_minutes": {
      "type": "number",
      "default": 5
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linkedin_snippets_json": {
      "type": "string",
      "description": "JSON array of reusable LinkedIn content snippets (carousel, short post, quote, long-form)"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "og_image_url": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}