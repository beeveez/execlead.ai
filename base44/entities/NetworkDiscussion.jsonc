{
  "name": "NetworkDiscussion",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "replies_json": {
      "type": "string"
    },
    "upvotes_count": {
      "type": "number",
      "default": 0
    },
    "upvoted_by_json": {
      "type": "string"
    },
    "accepted_answer_id": {
      "type": "string"
    },
    "bookmarks_json": {
      "type": "string"
    },
    "ai_summary": {
      "type": "string"
    },
    "views_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}