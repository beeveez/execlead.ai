{
  "name": "BetaApplication",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "application_id": {
      "type": "string",
      "description": "Unique Application ID (FB-YYYY-NNNNNN) \u2014 generated on submission, stored permanently"
    },
    "first_name": {
      "type": "string",
      "description": "Applicant first name"
    },
    "last_name": {
      "type": "string",
      "description": "Applicant last name"
    },
    "full_name": {
      "type": "string",
      "description": "Applicant full name (derived from first + last)"
    },
    "email": {
      "type": "string",
      "description": "Applicant email \u2014 used for invitation"
    },
    "company": {
      "type": "string",
      "description": "Current company"
    },
    "current_role": {
      "type": "string",
      "description": "Current job title"
    },
    "years_of_experience": {
      "type": "number",
      "description": "Total years of professional experience"
    },
    "leadership_level": {
      "type": "string",
      "enum": [
        "individual_contributor",
        "team_lead",
        "manager",
        "senior_manager",
        "director",
        "senior_director",
        "vp",
        "svp",
        "c_suite",
        "founder",
        "consultant",
        "other"
      ],
      "description": "Leadership level in organization"
    },
    "country": {
      "type": "string",
      "description": "Applicant country of residence"
    },
    "team_size": {
      "type": "string",
      "enum": [
        "individual",
        "1_5",
        "6_10",
        "11_25",
        "26_50",
        "51_100",
        "101_250",
        "251_500",
        "500_plus"
      ],
      "description": "Size of team the applicant leads or works in"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL (optional)"
    },
    "why_join": {
      "type": "string",
      "description": "Why the applicant wants to join the beta program"
    },
    "primary_goal": {
      "type": "string",
      "enum": [
        "promotion",
        "leadership_growth",
        "executive_interview",
        "career_transition",
        "other"
      ],
      "description": "Primary goal for joining EXECLEAD.AI"
    },
    "interested_capabilities": {
      "type": "string",
      "description": "JSON array of capability strings the applicant is interested in"
    },
    "how_heard": {
      "type": "string",
      "enum": [
        "linkedin",
        "twitter",
        "facebook",
        "youtube",
        "reddit",
        "google_search",
        "ai_assistant",
        "friend_colleague",
        "employer",
        "conference_event",
        "newsletter",
        "direct_invitation",
        "other"
      ],
      "description": "How the applicant heard about EXECLEAD.AI"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "email_verified",
        "under_review",
        "additional_info_required",
        "interview",
        "approved",
        "invitation_sent",
        "account_activated",
        "declined",
        "withdrawn"
      ],
      "default": "submitted",
      "description": "Admissions workflow status \u2014 every change is timestamped in timeline_json"
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the applicant has verified their email"
    },
    "email_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "beta_tier": {
      "type": "string",
      "enum": [
        "founding_beta",
        "private_beta",
        "exec_beta",
        "enterprise_beta",
        "commercial_beta"
      ],
      "default": "founding_beta",
      "description": "Beta feature flag tier assigned to this applicant"
    },
    "beta_stage": {
      "type": "string",
      "enum": [
        "founding_private_beta",
        "early_access",
        "open_beta",
        "general_availability"
      ],
      "default": "founding_private_beta",
      "description": "Beta release stage when this application was submitted"
    },
    "application_score": {
      "type": "number",
      "default": 0,
      "description": "Application Assessment Score 0-100 \u2014 computed on submission"
    },
    "assigned_reviewer_id": {
      "type": "string",
      "description": "Admin reviewer assigned to this application"
    },
    "assigned_reviewer_name": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string",
      "description": "Reviewer notes visible in decision history"
    },
    "internal_comments": {
      "type": "string",
      "description": "Internal reviewer comments \u2014 not shown to applicant"
    },
    "approval_reason": {
      "type": "string",
      "description": "Reason recorded when application is approved"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason recorded when application is declined"
    },
    "additional_info_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether additional information has been requested from the applicant"
    },
    "additional_info_details": {
      "type": "string",
      "description": "What additional information was requested"
    },
    "interview_scheduled": {
      "type": "boolean",
      "default": false
    },
    "interview_date": {
      "type": "string",
      "format": "date-time"
    },
    "invitation_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "invitation_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the invitation was accepted by the applicant"
    },
    "invitation_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account ID once activated"
    },
    "founding_member_number": {
      "type": "string",
      "description": "Assigned founding member number on approval (FM-YYYY-NNNNNN)"
    },
    "beta_cohort": {
      "type": "string",
      "description": "Beta cohort assignment (e.g. Batch #1)"
    },
    "founding_badge_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Eligible for Founding Member Badge \u2014 hidden until approval"
    },
    "founding_pricing_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Eligible for Founding Member pricing \u2014 hidden until approval"
    },
    "founding_member_assigned": {
      "type": "boolean",
      "default": false,
      "description": "Whether founding member recognition has been assigned"
    },
    "timeline_json": {
      "type": "string",
      "description": "JSON array of timeline stages [{stage, status, timestamp, note}]"
    },
    "audit_trail_json": {
      "type": "string",
      "description": "JSON array of immutable audit events [{timestamp, event, actor, reviewer, reason}]"
    },
    "decision_history_json": {
      "type": "string",
      "description": "JSON array of decision records [{decision, reason, reviewer, timestamp}]"
    },
    "notification_history_json": {
      "type": "string",
      "description": "JSON array of notification delivery records [{template, channel, sent_at, status}]"
    },
    "nps_score": {
      "type": "number",
      "description": "Net Promoter Score from beta feedback (0-10)"
    },
    "feedback_count": {
      "type": "number",
      "default": 0,
      "description": "Number of feedback submissions"
    },
    "bug_report_count": {
      "type": "number",
      "default": 0,
      "description": "Number of bug reports submitted"
    },
    "feature_request_count": {
      "type": "number",
      "default": 0,
      "description": "Number of feature requests submitted"
    },
    "is_active_beta_user": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user is currently active in the beta program"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}