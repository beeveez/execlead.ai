{
  "name": "ExecutiveReputation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string",
      "description": "User this reputation belongs to"
    },
    "user_name": {
      "type": "string"
    },
    "user_photo": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "professional_headline": {
      "type": "string"
    },
    "reputation_score": {
      "type": "number",
      "default": 0,
      "description": "Executive Reputation Score 0-1000"
    },
    "reputation_tier": {
      "type": "string",
      "enum": [
        "new_member",
        "contributor",
        "rising_leader",
        "executive_contributor",
        "distinguished_executive",
        "elite_executive",
        "leadership_fellow",
        "global_thought_leader"
      ],
      "default": "new_member"
    },
    "badges_json": {
      "type": "string",
      "description": "JSON array of {id, earned_at, reason}"
    },
    "achievements_json": {
      "type": "string",
      "description": "JSON array of {id, earned_at, reason}"
    },
    "milestones_json": {
      "type": "string",
      "description": "JSON array of {id, earned_at, value}"
    },
    "competencies_json": {
      "type": "string",
      "description": "JSON object of competency_id to score 0-100"
    },
    "total_letters": {
      "type": "number",
      "default": 0
    },
    "total_comments": {
      "type": "number",
      "default": 0
    },
    "total_contributions": {
      "type": "number",
      "default": 0
    },
    "average_quality_score": {
      "type": "number",
      "default": 0
    },
    "helpful_responses": {
      "type": "number",
      "default": 0
    },
    "featured_contributions": {
      "type": "number",
      "default": 0
    },
    "moderator_recognitions": {
      "type": "number",
      "default": 0
    },
    "community_awards": {
      "type": "number",
      "default": 0
    },
    "warnings_count": {
      "type": "number",
      "default": 0
    },
    "violations_count": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "reputation_trend": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "stable"
      ],
      "default": "stable"
    },
    "previous_score": {
      "type": "number",
      "default": 0
    },
    "lifetime_score": {
      "type": "number",
      "default": 0,
      "description": "Highest score ever achieved"
    },
    "monthly_recognitions_json": {
      "type": "string",
      "description": "JSON array of {type, month, year, title}"
    },
    "improvement_recommendations_json": {
      "type": "string",
      "description": "JSON array of recommendation strings"
    },
    "last_calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "community_trust_score": {
      "type": "number",
      "default": 0,
      "description": "Community Trust 0-100 (synced from UserProfile)"
    },
    "leadership_influence_pct": {
      "type": "number",
      "default": 0,
      "description": "Leadership Influence 0-100%"
    },
    "contribution_score": {
      "type": "number",
      "default": 0,
      "description": "Contribution Score 0-100"
    },
    "professional_conduct_score": {
      "type": "number",
      "default": 0,
      "description": "Professional Conduct 0-100"
    },
    "mentorship_score": {
      "type": "number",
      "default": 0,
      "description": "Mentorship Score 0-100"
    },
    "executive_credibility_score": {
      "type": "number",
      "default": 0,
      "description": "Executive Credibility 0-100"
    },
    "overall_executive_rating": {
      "type": "string",
      "default": "F",
      "description": "A+ to F rating"
    },
    "weighted_breakdown_json": {
      "type": "string",
      "description": "JSON array of {pillar, weight, score, points}"
    },
    "quality_dimensions_json": {
      "type": "string",
      "description": "JSON object of 10 quality dimension scores"
    },
    "quality_history_json": {
      "type": "string",
      "description": "JSON of {monthly, yearly, highest_rated, most_helpful, most_read_letter}"
    },
    "ai_executive_insights_json": {
      "type": "string",
      "description": "JSON of {insights, strengths, growth_areas}"
    },
    "ai_insights_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "simulations_completed": {
      "type": "number",
      "default": 0
    },
    "courses_completed": {
      "type": "number",
      "default": 0
    },
    "mentoring_hours": {
      "type": "number",
      "default": 0
    },
    "thought_leadership_index": {
      "type": "number",
      "leadership_index": 0
    },
    "total_views": {
      "type": "number",
      "default": 0
    },
    "gaming_risk_score": {
      "type": "number",
      "default": 0,
      "description": "Anti-gaming risk 0-100 (higher = more risk)"
    },
    "gaming_flags_json": {
      "type": "string",
      "description": "badge_earned JSON array of gaming risk flag strings"
    },
    "reputation_suspended": {
      "type": "boolean",
      "default": false
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspension_reason": {
      "type": "string"
    },
    "suspended_by_id": {
      "type": "string"
    },
    "suspended_by_name": {
      "type": "string"
    },
    "council_review_status": {
      "type": "string",
      "enum": [
        "none",
        "under_review",
        "investigating",
        "resolved",
        "escalated"
      ],
      "default": "none",
      "description": "Reputation Council review status"
    },
    "council_review_reason": {
      "type": "string"
    },
    "council_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "council_reviewer_id": {
      "type": "string"
    },
    "council_reviewer_name": {
      "type": "string"
    },
    "yearly_honors_json": {
      "type": "string",
      "description": "JSON array of {year, award, title, awarded_at}"
    },
    "community_rank": {
      "type": "number",
      "default": 0,
      "description": "Current community ranking by reputation"
    },
    "leaderboard_positions_json": {
      "type": "string",
      "description": "JSON object of leaderboard_id to rank"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}