{
  "name": "RoadmapProposal",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "strengthens_readiness": {
      "type": "boolean",
      "default": false
    },
    "improves_enterprise_value": {
      "type": "boolean",
      "default": false
    },
    "reinforces_positioning": {
      "type": "boolean",
      "default": false
    },
    "customer_driven": {
      "type": "boolean",
      "default": false
    },
    "feature_parity_only": {
      "type": "boolean",
      "default": false
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "Prioritize",
        "Consider",
        "Defer",
        "Reject"
      ],
      "default": "Consider"
    },
    "ai_analysis": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "reviewing",
        "accepted",
        "rejected"
      ],
      "default": "proposed"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}