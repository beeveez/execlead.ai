{
  "name": "ReferralTransaction",
  "type": "object",
  "properties": {
    "referral_id": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referrer_name": {
      "type": "string"
    },
    "invitee_user_id": {
      "type": "string"
    },
    "invitee_name": {
      "type": "string"
    },
    "invitee_email": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "subscription_amount": {
      "type": "number",
      "default": 0
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "commission_rate": {
      "type": "number",
      "default": 0
    },
    "founding_bonus_applied": {
      "type": "boolean",
      "default": false
    },
    "founding_bonus_amount": {
      "type": "number",
      "default": 0
    },
    "reward_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "payout_status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "paid"
      ],
      "default": "pending"
    },
    "payout_date": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "referral_id",
    "referrer_user_id"
  ],
  "rls": {
    "create": {
      "data.referrer_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}