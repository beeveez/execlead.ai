{
  "name": "LearningAssignment",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "learning_path": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "in_progress",
        "completed",
        "overdue"
      ],
      "default": "assigned"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "assigned_by_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "title",
    "assignee_name",
    "learning_path"
  ]
}