      "type": "string"
    },
    "leadership_style": {
      "type": "string"
    },
    "work_model": {
      "type": "string",
      "enum": [
        "remote",
        "hybrid",
        "onsite",
        "flexible"
      ],
      "default": "hybrid"
    },
    "remote_work_friendly": {
      "type": "boolean",
      "default": false
    },
    "hybrid_work_friendly": {
      "type": "boolean",
      "default": false
    },
    "executive_level_focus": {
      "type": "string"
    },
    "salary_benchmarks": {
      "type": "string"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "growth_potential": {
      "type": "string"
    },
    "career_opportunities": {
      "type": "string"
    },
    "promotion_expectations": {
      "type": "string"
    },
    "recommended_certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_courses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_paths_json": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strategic_priorities": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "archived"
      ],
      "default": "approved"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "subsidiary",
        "government",
        "non_profit"
      ],
      "default": "private"
    },
    "stock_symbol": {
      "type": "string"
    },
    "quality_score": {
      "type": "number",
      "default": 0
    },
    "reviewed_by": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "official_website": {
      "type": "string"
    },
    "profile_status": {
      "type": "string",
      "enum": [
        "independent",
        "verified",
        "official_partner",
        "strategic_partner"
      ],
      "default": "independent"
    },
    "is_claimed": {
      "type": "boolean",
      "default": false
    },
    "claimed_by": {
      "type": "string"
    },
    "claimed_email": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_date": {
      "type": "string",
      "format": "date"
    },
    "verification_notes": {
      "type": "string"
    },
    "source_attributions_json": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}