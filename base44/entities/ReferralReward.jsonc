{
  "name": "ReferralReward",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "required_referrals": {
      "type": "number",
      "default": 1
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "free_months",
        "plan_upgrade",
        "custom"
      ],
      "default": "free_months"
    },
    "reward_description": {
      "type": "string"
    },
    "plan_scope": {
      "type": "string"
    },
    "months_rewarded": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "required_referrals",
    "reward_type"
  ]
}