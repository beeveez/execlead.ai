{
  "name": "CPQAIPackage",
  "type": "object",
  "properties": {
    "package_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "monthly_requests": {
      "type": "number",
      "default": 0
    },
    "storage_gb": {
      "type": "number",
      "default": 0
    },
    "priority_processing": {
      "type": "boolean",
      "default": false
    },
    "advanced_models": {
      "type": "boolean",
      "default": false
    },
    "monthly_price": {
      "type": "number",
      "default": 0
    },
    "annual_price": {
      "type": "number",
      "default": 0
    },
    "is_per_user": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "package_id",
    "name"
  ]
}