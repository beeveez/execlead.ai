{
  "name": "IdentityVersion",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "label": {
      "type": "string"
    },
    "snapshot_json": {
      "type": "string"
    },
    "import_source": {
      "type": "string",
      "enum": [
        "resume_parser",
        "manual",
        "restore",
        "duplicate"
      ],
      "default": "manual"
    },
    "source_resume_url": {
      "type": "string"
    },
    "source_resume_name": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "default": 0
    },
    "parser_version": {
      "type": "string"
    },
    "imported_by": {
      "type": "string"
    },
    "completeness_score": {
      "type": "number",
      "default": 0
    },
    "change_summary": {
      "type": "string"
    }
  },
  "required": [
    "version_number"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}