{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "years_experience": {
      "type": "number"
    },
    "current_role": {
      "type": "string"
    },
    "current_company": {
      "type": "string"
    },
    "target_company": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "leadership_experience": {
      "type": "string"
    },
    "certifications": {
      "type": "string"
    },
    "career_goals": {
      "type": "string"
    },
    "preferred_learning_style": {
      "type": "string"
    },
    "growth_plan": {
      "type": "string"
    },
    "ai_personality": {
      "type": "string",
      "default": "executive_mentor"
    },
    "interview_readiness": {
      "type": "number",
      "default": 0
    },
    "promotion_readiness": {
      "type": "number",
      "default": 0
    },
    "leadership_maturity": {
      "type": "number",
      "default": 0
    },
    "commercial_maturity": {
      "type": "number",
      "default": 0
    },
    "communication_growth": {
      "type": "number",
      "default": 0
    },
    "executive_presence": {
      "type": "number",
      "default": 0
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "challenges_completed": {
      "type": "number",
      "default": 0
    },
    "streak_days": {
      "type": "number",
      "default": 0
    },
    "last_active_date": {
      "type": "string",
      "format": "date"
    },
    "weak_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strong_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "xp_points": {
      "type": "number",
      "default": 0
    },
    "profile_photo": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "resume_url": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "custom_role": {
      "type": "string"
    },
    "subscription_plan": {
      "type": "string",
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "default": "active"
    },
    "subscription_cycle": {
      "type": "string",
      "default": "monthly"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bio": {
      "type": "string"
    }
  },
  "required": [
    "target_company",
    "target_role"
  ]
}