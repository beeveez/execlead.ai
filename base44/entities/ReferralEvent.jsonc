{
  "name": "ReferralEvent",
  "type": "object",
  "properties": {
    "referral_code": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "link_clicked",
        "landing_viewed",
        "registration_completed",
        "email_verified",
        "subscription_started",
        "subscription_renewed",
        "upgrade",
        "downgrade",
        "cancellation",
        "refund",
        "chargeback"
      ]
    },
    "invitee_email": {
      "type": "string"
    },
    "invitee_user_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "landing_page": {
      "type": "string"
    },
    "metadata_json": {
      "type": "string"
    }
  },
  "required": [
    "referral_code",
    "event_type"
  ]
}