{
  "name": "ReputationAuditLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string",
      "description": "User whose reputation changed"
    },
    "user_name": {
      "type": "string"
    },
    "previous_score": {
      "type": "number",
      "default": 0
    },
    "new_score": {
      "type": "number",
      "default": 0
    },
    "change_amount": {
      "type": "number",
      "default": 0
    },
    "reason": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai_assessment",
        "moderator_action",
        "community_recognition",
        "recalculation",
        "penalty",
        "badge_earned",
        "badge_revoked",
        "manual_adjustment",
        "suspension",
        "restoration",
        "feature",
        "council_decision",
        "appeal_resolution",
        "achievement_earned",
        "milestone_reached",
        "honor_awarded"
      ],
      "default": "recalculation"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "adjust_score",
        "award_badge",
        "remove_badge",
        "feature_member",
        "suspend",
        "restore",
        "recalculate",
        "recognize",
        "council_review",
        "appeal_approve",
        "appeal_deny",
        "award_achievement",
        "award_honor",
        "revoke_badge",
        "remove_achievement"
      ],
      "description": "Specific action type"
    },
    "contribution_id": {
      "type": "string"
    },
    "contribution_type": {
      "type": "string",
      "description": "letter, comment, discussion, etc."
    },
    "ai_recommendation": {
      "type": "string",
      "description": "AI-suggested action or assessment"
    },
    "moderator_decision": {
      "type": "string",
      "description": "Moderator's decision notes"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "details_json": {
      "type": "string",
      "description": "JSON object with additional context"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "new_score"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "platform_admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__immutable__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}