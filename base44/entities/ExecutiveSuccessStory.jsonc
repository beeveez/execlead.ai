{
  "name": "ExecutiveSuccessStory",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "story_id": {
      "type": "string",
      "description": "Unique story ID (SS-YYYY-NNNNNN)"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "user_name": {
      "type": "string",
      "description": "Display name (blank for anonymous)"
    },
    "user_role": {
      "type": "string"
    },
    "journey_start": {
      "type": "string",
      "format": "date"
    },
    "journey_end": {
      "type": "string",
      "format": "date"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "anonymous",
        "named"
      ],
      "default": "private"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "granted",
        "revoked"
      ],
      "default": "not_requested"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "narrative": {
      "type": "string",
      "description": "Markdown narrative"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics_snapshot_json": {
      "type": "string",
      "description": "JSON of success metrics (readiness, counts, journey level)"
    },
    "evidence_snapshot_json": {
      "type": "string"
    },
    "outcome_snapshot_json": {
      "type": "string"
    },
    "recommendations_followed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_insights_json": {
      "type": "string"
    },
    "charts_json": {
      "type": "string"
    },
    "timeline_json": {
      "type": "string"
    },
    "share_url": {
      "type": "string"
    },
    "pdf_file_url": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "industry": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    }
  },
  "required": [
    "story_id",
    "user_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}