{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app. Roles govern access scope and are independent of subscription plans.",
      "enum": [
        "guest",
        "customer",
        "enterprise_user",
        "enterprise_admin",
        "support",
        "sales",
        "finance",
        "content_manager",
        "platform_admin",
        "developer",
        "super_admin",
        "free_user",
        "professional_user",
        "executive_user",
        "instructor",
        "coach",
        "admin",
        "user"
      ]
    }
  },
  "required": [
    "role"
  ]
}