{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "submission_type": {
      "type": "string",
      "enum": [
        "contact",
        "security_report"
      ],
      "default": "contact",
      "description": "Type of intake submission"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "description": "Submitter display name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 300,
      "description": "Submitter contact email"
    },
    "subject": {
      "type": "string",
      "maxLength": 300,
      "description": "Optional short subject / affected area"
    },
    "message": {
      "type": "string",
      "maxLength": 6000,
      "description": "Full message or security report description"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "new"
    },
    "internal_notes": {
      "type": "string",
      "maxLength": 3000,
      "description": "Admin-only handling notes"
    },
    "source_page": {
      "type": "string",
      "maxLength": 200,
      "description": "Page the submission originated from (e.g. /contact, /trust-center)"
    }
  },
  "required": [
    "submission_type",
    "email",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "support"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "support"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "support"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}