{
  "name": "ResumeVersion",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "extracted_data": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "description": "Fingerprint of normalized resume content — used for deduplication"
    },
    "created_by": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "system"
      ],
      "default": "user",
      "description": "Who created this version"
    },
    "creation_reason": {
      "type": "string",
      "enum": [
        "upload",
        "manual_edit",
        "ai_rewrite",
        "save_as_new",
        "onboarding",
        "import"
      ],
      "default": "upload",
      "description": "Why this version was created"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Marks the active/current resume version"
    },
    "learning_roadmap": {
      "type": "string"
    },
    "enhancement_report": {
      "type": "string"
    }
  },
  "required": [
    "file_url",
    "file_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
