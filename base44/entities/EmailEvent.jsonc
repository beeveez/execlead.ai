{
  "name": "EmailEvent",
  "type": "object",
  "properties": {
    "recipient": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "delivered",
        "opened",
        "clicked",
        "bounced",
        "spam",
        "failed",
        "retry",
        "cancelled",
        "sent",
        "not_configured"
      ],
      "default": "queued"
    },
    "error_message": {
      "type": "string"
    },
    "email_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "provider_response": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "recipient",
    "subject"
  ]
}