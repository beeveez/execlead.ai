{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "legal_name": {
      "type": "string",
      "description": "Legal entity name"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "logo_url": {
      "type": "string"
    },
    "brand_color": {
      "type": "string",
      "default": "#6366f1"
    },
    "domain": {
      "type": "string",
      "description": "Primary domain (e.g. acme.com)"
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "description": "Geographic region"
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1001-5000",
        "5001-10000",
        "10000+"
      ],
      "description": "Company size band"
    },
    "employee_count": {
      "type": "number",
      "default": 0
    },
    "tenant_type": {
      "type": "string",
      "enum": [
        "single",
        "multi",
        "enterprise",
        "education",
        "government",
        "partner"
      ],
      "default": "enterprise",
      "description": "Organization tenant classification"
    },
    "organization_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "pending"
      ],
      "default": "pending"
    },
    "parent_organization_id": {
      "type": "string",
      "description": "Parent org for multi-tenant hierarchy"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "executive",
        "enterprise"
      ],
      "default": "enterprise"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "pending"
    },
    "seats_total": {
      "type": "number",
      "default": 10
    },
    "seats_used": {
      "type": "number",
      "default": 0
    },
    "workspaces_enabled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Enabled workspace IDs"
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admin_user_id": {
      "type": "string"
    },
    "admin_email": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "proposal_number": {
      "type": "string"
    },
    "ai_package_id": {
      "type": "string"
    },
    "support_package_id": {
      "type": "string"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "contract_url": {
      "type": "string"
    },
    "annual_value": {
      "type": "number",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "contract_length_years": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.id": "{{user.data.organization_id}}"
        },
        {
          "data.admin_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.admin_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}