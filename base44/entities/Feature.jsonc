{
  "name": "Feature",
  "type": "object",
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "minimum_plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "executive",
        "enterprise"
      ],
      "default": "free"
    },
    "required_role": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "development",
        "internal",
        "beta",
        "preview",
        "live",
        "deprecated",
        "archived"
      ],
      "default": "live"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "hidden"
      ],
      "default": "public"
    },
    "coming_soon": {
      "type": "boolean",
      "default": false
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "expected_release": {
      "type": "string"
    },
    "nav_enabled": {
      "type": "boolean",
      "default": false
    },
    "pricing_enabled": {
      "type": "boolean",
      "default": true
    },
    "route_path": {
      "type": "string"
    },
    "nav_label": {
      "type": "string"
    },
    "is_enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "limit_label": {
      "type": "string"
    }
  },
  "required": [
    "feature_id",
    "name"
  ]
}