{
  "name": "ShareEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "achievement_type": {
      "type": "string"
    },
    "achievement_title": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "recruiter_visible",
        "organization_only"
      ],
      "default": "public"
    },
    "hide_name": {
      "type": "boolean",
      "default": false
    },
    "hide_score": {
      "type": "boolean",
      "default": false
    },
    "hide_company": {
      "type": "boolean",
      "default": false
    },
    "hide_resume": {
      "type": "boolean",
      "default": false
    },
    "hide_personal_info": {
      "type": "boolean",
      "default": false
    },
    "executive_score": {
      "type": "number"
    },
    "leadership_level": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "share_url": {
      "type": "string"
    },
    "is_enterprise": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "achievement_type",
    "platform"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
