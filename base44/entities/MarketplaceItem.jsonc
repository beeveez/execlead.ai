{
  "name": "MarketplaceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "learning_path",
        "company_pack",
        "interview_pack",
        "certification_track",
        "executive_playbook",
        "presentation_template",
        "case_study",
        "industry_framework",
        "executive_book",
        "ai_prompt_library",
        "board_pack",
        "strategy_toolkit",
        "executive_bundle"
      ]
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "icon": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_type": {
      "type": "string",
      "enum": [
        "execlead",
        "partner",
        "creator"
      ],
      "default": "execlead"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "content_preview": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "duration_hours": {
      "type": "number",
      "default": 0
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "executive"
      ],
      "default": "executive"
    },
    "collection": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "bundle_name": {
      "type": "string"
    },
    "executive_level": {
      "type": "string"
    },
    "pages": {
      "type": "number",
      "default": 0
    },
    "video_duration_minutes": {
      "type": "number",
      "default": 0
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "is_bundle": {
      "type": "boolean",
      "default": false
    },
    "license_type": {
      "type": "string",
      "enum": [
        "free",
        "one_time",
        "monthly",
        "annual",
        "enterprise",
        "department",
        "seat"
      ],
      "default": "free"
    },
    "enterprise_included": {
      "type": "boolean",
      "default": false
    },
    "partner_verified": {
      "type": "boolean",
      "default": false
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "none",
        "university",
        "consulting_firm",
        "training_provider",
        "executive_coach",
        "author",
        "technology_vendor",
        "certification_body"
      ],
      "default": "none"
    },
    "learning_outcomes_json": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "trending": {
      "type": "boolean",
      "default": false
    },
    "editors_choice": {
      "type": "boolean",
      "default": false
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "industry": {
      "type": "string"
    },
    "company": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}