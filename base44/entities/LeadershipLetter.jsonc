{
  "name": "LeadershipLetter",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "author_user_id": {
      "type": "string",
      "description": "Author's user ID"
    },
    "author_name": {
      "type": "string"
    },
    "author_photo": {
      "type": "string"
    },
    "author_headline": {
      "type": "string",
      "description": "Author's professional headline at time of publication"
    },
    "author_founder_number": {
      "type": "string",
      "description": "Founder number if the author is a founding member"
    },
    "author_is_founder": {
      "type": "boolean",
      "default": false
    },
    "author_verification_badge": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "subtitle": {
      "type": "string",
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "description": "Letter type/category"
    },
    "message": {
      "type": "string",
      "description": "Main letter body"
    },
    "author_position": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "years_experience": {
      "type": "number",
      "default": 0
    },
    "leadership_level": {
      "type": "string",
      "description": "e.g. C-Suite, VP, Director, Senior Manager"
    },
    "key_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advice": {
      "type": "string"
    },
    "recommended_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_courses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_habits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reflection_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closing_message": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "presentation_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_ai_review",
        "pending_human_review",
        "revision_requested",
        "published",
        "rejected",
        "archived"
      ],
      "default": "draft",
      "description": "Editorial lifecycle state"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Editing locked once submitted"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featured_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "featured",
          "pinned",
          "editors_pick",
          "founders_choice",
          "trending",
          "homepage_featured"
        ]
      },
      "description": "Featured content classifications"
    },
    "curated_collections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Collection IDs this letter belongs to"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "bookmarks": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "ai_summary": {
      "type": "string"
    },
    "ai_competencies_json": {
      "type": "string",
      "description": "JSON array of leadership competencies"
    },
    "ai_principles_json": {
      "type": "string",
      "description": "JSON array of leadership principles"
    },
    "ai_decision_themes_json": {
      "type": "string",
      "description": "JSON array of decision themes"
    },
    "ai_communication_style": {
      "type": "string"
    },
    "ai_executive_skills_json": {
      "type": "string",
      "description": "JSON array of executive skills"
    },
    "ai_recommended_audience": {
      "type": "string"
    },
    "ai_key_takeaways_json": {
      "type": "string",
      "description": "JSON array of key takeaways"
    },
    "ai_reading_time_minutes": {
      "type": "number",
      "default": 0
    },
    "ai_moderation_score": {
      "type": "number",
      "default": 0,
      "description": "Overall AI moderation score 0-100"
    },
    "ai_grammar_score": {
      "type": "number",
      "default": 0
    },
    "ai_tone_score": {
      "type": "number",
      "default": 0
    },
    "ai_leadership_value_score": {
      "type": "number",
      "default": 0
    },
    "ai_originality_score": {
      "type": "number",
      "default": 0
    },
    "ai_risk_score": {
      "type": "number",
      "default": 0
    },
    "ai_recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "needs_review",
        "reject"
      ],
      "description": "AI moderation recommendation"
    },
    "ai_suggested_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_review_json": {
      "type": "string",
      "description": "Full AI moderation review details"
    },
    "ai_flags_json": {
      "type": "string",
      "description": "JSON of toxicity/spam/plagiarism/sensitive_info flags"
    },
    "revision_notes": {
      "type": "string",
      "description": "Moderator's revision instructions to author"
    },
    "revision_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision_count": {
      "type": "number",
      "default": 0
    },
    "rejection_reason": {
      "type": "string",
      "enum": [
        "spam",
        "low_quality",
        "duplicate",
        "policy_violation",
        "incomplete",
        "copyright_issue",
        "other"
      ]
    },
    "rejection_comments": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_by_id": {
      "type": "string"
    },
    "rejected_by_name": {
      "type": "string"
    },
    "publication_url": {
      "type": "string",
      "description": "Permanent public URL slug"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executive_citation": {
      "type": "string",
      "description": "Formatted citation for executive reference"
    },
    "scheduled_publish_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_reviewer_id": {
      "type": "string"
    },
    "assigned_reviewer_name": {
      "type": "string"
    },
    "moderator_notes": {
      "type": "string",
      "description": "Internal notes for moderators"
    },
    "review_checklist_json": {
      "type": "string",
      "description": "JSON of moderator checklist state"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "review_round": {
      "type": "number",
      "default": 0,
      "description": "How many review cycles this letter has gone through"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    }
  },
  "required": [
    "author_user_id",
    "title",
    "category",
    "message"
  ]
}