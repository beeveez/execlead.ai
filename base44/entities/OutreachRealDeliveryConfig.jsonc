{
  "name": "OutreachRealDeliveryConfig",
  "type": "object",
  "description": "Phase 14D single global real-delivery activation control for the governed Google Workspace Gmail outreach delivery path. Real Gmail delivery requires BOTH this record being real_delivery_enabled=true AND the google_workspace_gmail ExternalDeliveryConnectorRegistry record being ACTIVE+enabled, plus a verified human-approved governed OutreachDeliveryRequest with a server-resolved recipient \u2014 each is a separate explicit operator action and none ever happens automatically. If this record is missing, the delivery gate fails closed (treated as disabled).",
  "properties": {
    "config_id": {
      "type": "string",
      "description": "Single authoritative record identifier: outreach_real_delivery_global"
    },
    "real_delivery_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Global real-delivery permission. Default and current value: false. Enabling is an explicit operator action, is never performed by the platform, by an agent, or by code, and does not by itself permit any send."
    },
    "updated_by": {
      "type": "string",
      "description": "User id of the operator who last changed this activation control"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this activation control was last changed"
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Operational reason for the last activation change (incident reference, operator review, etc.)"
    }
  },
  "required": [
    "config_id",
    "real_delivery_enabled"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}