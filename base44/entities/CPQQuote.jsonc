{
  "name": "CPQQuote",
  "type": "object",
  "properties": {
    "proposal_number": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "accepted",
        "contract_signed",
        "invoice_issued",
        "payment_pending",
        "paid",
        "provisioned",
        "active",
        "rejected",
        "expired"
      ],
      "default": "draft"
    },
    "organization_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "headquarters": {
      "type": "string"
    },
    "company_size": {
      "type": "string"
    },
    "annual_revenue": {
      "type": "string"
    },
    "num_employees": {
      "type": "number"
    },
    "expected_active_users": {
      "type": "number"
    },
    "expected_managers": {
      "type": "number"
    },
    "expected_executives": {
      "type": "number"
    },
    "implementation_timeline": {
      "type": "string"
    },
    "current_lms": {
      "type": "string"
    },
    "current_hr_platform": {
      "type": "string"
    },
    "current_identity_provider": {
      "type": "string"
    },
    "config_json": {
      "type": "string"
    },
    "breakdown_json": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "contract_length_years": {
      "type": "number",
      "default": 1
    },
    "annual_value": {
      "type": "number",
      "default": 0
    },
    "total_contract_value": {
      "type": "number",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "default": 0
    },
    "assigned_to": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "contract_url": {
      "type": "string"
    },
    "contract_signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_name": {
      "type": "string"
    },
    "signature_title": {
      "type": "string"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "bank_transfer",
        "wire_transfer",
        "purchase_order"
      ]
    },
    "payment_provider": {
      "type": "string"
    },
    "payment_transaction_id": {
      "type": "string"
    },
    "po_number": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "organization_id": {
      "type": "string"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "share_token": {
      "type": "string"
    },
    "change_request_notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "proposal_number",
    "organization_name",
    "organization_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
