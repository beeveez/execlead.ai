{
  "name": "AccountDeletionRequest",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "verification_pending",
        "pending_deletion",
        "cancelled",
        "restored",
        "completed"
      ],
      "default": "verification_pending"
    },
    "deletion_mode": {
      "type": "string",
      "enum": [
        "immediate",
        "delayed_14",
        "delayed_30"
      ],
      "description": "User-selected deletion timing"
    },
    "grace_period_days": {
      "type": "number",
      "default": 0,
      "description": "Grace period in days (0 for immediate)"
    },
    "verification_code": {
      "type": "string",
      "description": "6-digit email verification code"
    },
    "verification_code_expires": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "description": "Optional user-provided deletion reason"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_deletion_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the account will be deleted (null for immediate)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When retained legal records can be purged"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "blocked_reasons_json": {
      "type": "string",
      "description": "JSON array of pre-deletion check failures"
    },
    "deletion_summary_json": {
      "type": "string",
      "description": "JSON summary of deleted entities when completed"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        }
      ]
    }
  }
}