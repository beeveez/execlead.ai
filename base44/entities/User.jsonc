{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app. Roles govern access scope and are independent of subscription plans.",
      "enum": [
        "guest",
        "customer",
        "enterprise_user",
        "enterprise_admin",
        "support",
        "sales",
        "finance",
        "content_manager",
        "platform_admin",
        "developer",
        "super_admin",
        "free_user",
        "professional_user",
        "executive_user",
        "instructor",
        "coach",
        "admin",
        "user",
        "founder_root_admin"
      ]
    },
    "appearance_theme": {
      "type": "string",
      "description": "User's appearance theme preference: dark, light, or system.",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "dark"
    },
    "organization_id": {
      "type": "string",
      "description": "The organization this user belongs to."
    },
    "assigned_assessment_track": {
      "type": "string",
      "description": "Enterprise-assigned assessment track."
    },
    "assessment_program_name": {
      "type": "string"
    },
    "assessment_sponsor": {
      "type": "string"
    },
    "leadership_track": {
      "type": "string"
    },
    "target_executive_role": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "default": 1
    },
    "onboarding_type": {
      "type": "string",
      "enum": [
        "individual",
        "executive",
        "enterprise_assigned"
      ],
      "default": "individual"
    },
    "readiness_calibrated": {
      "type": "boolean",
      "default": false
    },
    "readiness_level": {
      "type": "string",
      "default": "Not Calibrated"
    },
    "journey_points": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "role"
  ]
}