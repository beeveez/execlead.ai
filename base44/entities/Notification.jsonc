{
  "name": "Notification",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "type": {
      "type": "string",
      "enum": [
        "learning_reminder",
        "daily_challenge",
        "achievement",
        "subscription",
        "renewal",
        "system",
        "social",
        "feedback",
        "enterprise",
        "platform",
        "developer",
        "admissions"
      ]
    },
    "category": {
      "type": "string",
      "description": "Workspace-specific category (e.g. wallet, deployments, team_invitations)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "info"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "action_url": {
      "type": "string",
      "description": "Deep link URL \u2014 clicking the notification navigates here"
    },
    "icon": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Target user for personal notifications. Empty for broadcast/workspace/org scoped."
    },
    "organization_id": {
      "type": "string",
      "description": "Target organization for org-scoped notifications."
    },
    "workspace": {
      "type": "string",
      "enum": [
        "executive",
        "enterprise",
        "platform",
        "developer",
        "all"
      ],
      "default": "executive"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "organization",
        "workspace",
        "public"
      ],
      "default": "private"
    },
    "role_scope": {
      "type": "string",
      "description": "Comma-separated role keys that can see this notification. Empty means all roles in scope."
    },
    "entity_type": {
      "type": "string",
      "description": "Type of the originating entity (e.g. beta_application, referral, achievement, payment)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the originating entity \u2014 enables deep linking to the source record"
    },
    "routing_audit_json": {
      "type": "string",
      "description": "JSON array of routing audit steps [{step, timestamp, workspace, audience, deep_link, validation}]"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}