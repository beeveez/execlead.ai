{
  "name": "FoundingWaitlist",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string",
      "description": "User ID if the reserver is a registered user"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "profession": {
      "type": "string",
      "description": "Professional title/role for founder directory display"
    },
    "company": {
      "type": "string",
      "description": "Organization name for public founder profile"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector for directory filtering"
    },
    "photo": {
      "type": "string",
      "description": "Profile photo URL for public founder display"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL (optional, public display)"
    },
    "executive_score": {
      "type": "number",
      "default": 0,
      "description": "Executive leadership score (optional public display)"
    },
    "preferred_plan": {
      "type": "string",
      "enum": [
        "professional",
        "executive",
        "founding_member",
        "enterprise"
      ],
      "default": "professional"
    },
    "expected_start_date": {
      "type": "string",
      "format": "date"
    },
    "comments": {
      "type": "string",
      "maxLength": 2000
    },
    "founder_story": {
      "type": "string",
      "maxLength": 5000,
      "description": "Why I joined EXECLEAD.AI \u2014 career journey, leadership story, goals, advice"
    },
    "reservation_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "approved",
        "invited",
        "activated",
        "expired",
        "cancelled",
        "declined"
      ],
      "default": "reserved"
    },
    "priority_number": {
      "type": "number",
      "default": 0,
      "description": "Sequential position in the waitlist"
    },
    "founding_member_number": {
      "type": "string",
      "description": "Unique founder reservation number (FM-YYYY-NNNNNN)"
    },
    "certificate_id": {
      "type": "string",
      "description": "Unique certificate identifier"
    },
    "verification_id": {
      "type": "string",
      "description": "Public verification UUID for QR code authenticity check"
    },
    "pricing_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reserved founding pricing expires (30 days from reservation)"
    },
    "display_preference": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "anonymous"
      ],
      "default": "private",
      "description": "Founder's visibility choice on the Founders Wall"
    },
    "public_profile": {
      "type": "boolean",
      "default": false,
      "description": "Legacy field \u2014 superseded by display_preference"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Admin-featured founder for highlight display"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Admin-hidden from public Founders Wall"
    },
    "founder_achievements": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "first_10",
          "first_50",
          "first_100",
          "first_500",
          "original_beta_tester",
          "product_advisor",
          "community_champion",
          "top_referrer"
        ]
      },
      "description": "Achievement badges earned by this founder"
    },
    "invitation_sent": {
      "type": "boolean",
      "default": false
    },
    "payment_completed": {
      "type": "boolean",
      "default": false
    },
    "activated": {
      "type": "boolean",
      "default": false
    },
    "activation_date": {
      "type": "string",
      "format": "date-time"
    },
    "activated_by_id": {
      "type": "string"
    },
    "activated_by_name": {
      "type": "string"
    },
    "activation_reason": {
      "type": "string"
    },
    "assigned_plan": {
      "type": "string"
    },
    "founding_member_assigned": {
      "type": "boolean",
      "default": false
    },
    "payment_method": {
      "type": "string"
    },
    "referral_source": {
      "type": "string"
    },
    "notified_payments_live": {
      "type": "boolean",
      "default": false
    },
    "reminder_7day_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_3day_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email",
    "preferred_plan"
  ]
}