{
  "name": "CouncilSession",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "question": {
      "type": "string"
    },
    "personas_json": {
      "type": "string"
    },
    "perspectives_json": {
      "type": "string"
    },
    "debate_json": {
      "type": "string"
    },
    "decision_brief_json": {
      "type": "string"
    },
    "consolidated_recommendation": {
      "type": "string"
    },
    "overall_confidence": {
      "type": "number",
      "default": 0
    },
    "consensus_level": {
      "type": "string",
      "enum": [
        "unanimous",
        "strong",
        "moderate",
        "divided"
      ],
      "default": "moderate"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "reopened",
        "archived"
      ],
      "default": "completed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_summary": {
      "type": "string"
    },
    "action_items_json": {
      "type": "string"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}