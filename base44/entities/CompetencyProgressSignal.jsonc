{
  "name": "CompetencyProgressSignal",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "competency": {
      "type": "string",
      "description": "Competency being tracked (e.g. Strategic Thinking)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "declining"
      ],
      "default": "improving"
    },
    "progress_signal": {
      "type": "number",
      "default": 0,
      "description": "Growth signal 0-100"
    },
    "evidence_count": {
      "type": "number",
      "default": 0
    },
    "last_signal_score": {
      "type": "number",
      "default": 0
    },
    "avg_reflection_depth": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "default": "first_success_experience"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_json": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "competency"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}