{
  "name": "CPQModule",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "platform",
        "module",
        "service",
        "addon"
      ],
      "default": "module"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "monthly_price": {
      "type": "number",
      "default": 0
    },
    "annual_price": {
      "type": "number",
      "default": 0
    },
    "is_per_user": {
      "type": "boolean",
      "default": false
    },
    "included_plans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "module_id",
    "name",
    "type"
  ]
}