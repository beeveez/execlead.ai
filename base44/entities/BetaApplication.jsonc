{
  "name": "BetaApplication",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "application_id": {
      "type": "string",
      "description": "Unique Application ID (FB-YYYY-NNNNNN)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "current_role": {
      "type": "string"
    },
    "years_of_experience": {
      "type": "number"
    },
    "leadership_level": {
      "type": "string",
      "enum": [
        "individual_contributor",
        "team_lead",
        "manager",
        "senior_manager",
        "director",
        "senior_director",
        "vp",
        "svp",
        "c_suite",
        "founder",
        "consultant",
        "other"
      ]
    },
    "country": {
      "type": "string"
    },
    "team_size": {
      "type": "string",
      "enum": [
        "individual",
        "1_5",
        "6_10",
        "11_25",
        "26_50",
        "51_100",
        "101_250",
        "251_500",
        "500_plus"
      ]
    },
    "linkedin_url": {
      "type": "string"
    },
    "why_join": {
      "type": "string"
    },
    "primary_goal": {
      "type": "string",
      "enum": [
        "promotion",
        "leadership_growth",
        "executive_interview",
        "career_transition",
        "other"
      ]
    },
    "interested_capabilities": {
      "type": "string"
    },
    "how_heard": {
      "type": "string",
      "enum": [
        "linkedin",
        "twitter",
        "facebook",
        "youtube",
        "reddit",
        "google_search",
        "ai_assistant",
        "friend_colleague",
        "employer",
        "conference_event",
        "newsletter",
        "direct_invitation",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "email_verified",
        "under_review",
        "additional_info_required",
        "interview",
        "approved",
        "invitation_sent",
        "account_activated",
        "declined",
        "withdrawn"
      ],
      "default": "submitted"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "email_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "beta_tier": {
      "type": "string",
      "enum": [
        "founding_beta",
        "private_beta",
        "exec_beta",
        "enterprise_beta",
        "commercial_beta"
      ],
      "default": "founding_beta"
    },
    "beta_stage": {
      "type": "string",
      "enum": [
        "founding_private_beta",
        "early_access",
        "open_beta",
        "general_availability"
      ],
      "default": "founding_private_beta"
    },
    "application_score": {
      "type": "number",
      "default": 0
    },
    "assigned_reviewer_id": {
      "type": "string"
    },
    "assigned_reviewer_name": {
      "type": "string"
    },
    "reviewed_by_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    },
    "internal_comments": {
      "type": "string"
    },
    "approval_reason": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "additional_info_requested": {
      "type": "boolean",
      "default": false
    },
    "additional_info_details": {
      "type": "string"
    },
    "interview_scheduled": {
      "type": "boolean",
      "default": false
    },
    "interview_date": {
      "type": "string",
      "format": "date-time"
    },
    "invitation_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "invitation_accepted": {
      "type": "boolean",
      "default": false
    },
    "invitation_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    },
    "founding_member_number": {
      "type": "string"
    },
    "beta_cohort": {
      "type": "string"
    },
    "founding_badge_eligible": {
      "type": "boolean",
      "default": false
    },
    "founding_pricing_eligible": {
      "type": "boolean",
      "default": false
    },
    "founding_member_assigned": {
      "type": "boolean",
      "default": false
    },
    "on_hold": {
      "type": "boolean",
      "default": false,
      "description": "Whether the application is on hold"
    },
    "on_hold_reason": {
      "type": "string",
      "description": "Reason the application was put on hold"
    },
    "response_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for applicant to respond to information request"
    },
    "timeline_json": {
      "type": "string",
      "description": "JSON array of timeline stages [{stage, status, timestamp, note}]"
    },
    "audit_trail_json": {
      "type": "string",
      "description": "JSON array of immutable audit events [{timestamp, event, actor, reviewer, previous_status, new_status, reason, message_sent, email_status}]"
    },
    "decision_history_json": {
      "type": "string",
      "description": "JSON array of decision records [{decision, reason, reviewer, timestamp}]"
    },
    "notification_history_json": {
      "type": "string",
      "description": "JSON array of notification delivery records [{template, channel, sent_at, status}]"
    },
    "email_history_json": {
      "type": "string",
      "description": "JSON array of email delivery records [{subject, recipient, provider, template, sent_at, status, opened, clicked, retry_count, failure_reason, message_id}]"
    },
    "communications_json": {
      "type": "string",
      "description": "JSON array of reviewer-applicant communications [{type, direction, subject, message, reviewer, sent_at, email_status}]"
    },
    "nps_score": {
      "type": "number"
    },
    "feedback_count": {
      "type": "number",
      "default": 0
    },
    "bug_report_count": {
      "type": "number",
      "default": 0
    },
    "feature_request_count": {
      "type": "number",
      "default": 0
    },
    "is_active_beta_user": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
