{
  "name": "FoundingMember",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "founding_member_number": {
      "type": "string"
    },
    "founder_number": {
      "type": "string",
      "description": "Permanent Founder Identity Seal\u2122 number (e.g. FM-000001). Immutable \u2014 can never be edited, reassigned, or recycled."
    },
    "founder_rank": {
      "type": "number",
      "description": "Permanent founder rank (1 = first founder). Immutable."
    },
    "founder_since": {
      "type": "number",
      "description": "Year the founder joined (e.g. 2026). Immutable."
    },
    "lifetime_founder": {
      "type": "boolean",
      "default": false,
      "description": "Permanent lifetime founder status \u2014 never expires"
    },
    "founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Confirmed founding member"
    },
    "human_founder": {
      "type": "boolean",
      "default": false,
      "description": "Human founding member (not organizational)"
    },
    "founder_locked": {
      "type": "boolean",
      "default": false,
      "description": "Founder Identity Seal\u2122 \u2014 locks the entire founder record"
    },
    "identity_locked": {
      "type": "boolean",
      "default": false,
      "description": "Founder identity is permanently locked"
    },
    "certificate_locked": {
      "type": "boolean",
      "default": false,
      "description": "Founder certificate is permanently locked"
    },
    "founder_record_locked": {
      "type": "boolean",
      "default": false,
      "description": "Entire founder record is sealed \u2014 no modifications permitted"
    },
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "joined_date": {
      "type": "string",
      "format": "date"
    },
    "founding_batch": {
      "type": "string",
      "default": "Batch #1"
    },
    "founding_tier": {
      "type": "string",
      "enum": [
        "founding_member",
        "investor_member",
        "enterprise_founder",
        "advisory_council",
        "ambassador",
        "partner_founder"
      ],
      "default": "founding_member"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "active",
        "suspended",
        "expired",
        "legacy",
        "lifetime"
      ],
      "default": "active"
    },
    "founder_role": {
      "type": "string",
      "description": "Founder's role title (e.g. Founder & Chief Product Architect)"
    },
    "subscription_plan": {
      "type": "string",
      "default": "free"
    },
    "lifetime_discount_percentage": {
      "type": "number",
      "default": 25
    },
    "lifetime_discount_enabled": {
      "type": "boolean",
      "default": true
    },
    "discount_expiration": {
      "type": "string"
    },
    "protected_pricing": {
      "type": "boolean",
      "default": true
    },
    "badge_status": {
      "type": "string",
      "enum": [
        "granted",
        "issued",
        "visible",
        "enabled"
      ],
      "default": "granted"
    },
    "badge_issued_date": {
      "type": "string",
      "format": "date"
    },
    "early_access_enabled": {
      "type": "boolean",
      "default": true
    },
    "early_access_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_access": {
      "type": "boolean",
      "default": true
    },
    "beta_access": {
      "type": "boolean",
      "default": true
    },
    "roadmap_voting": {
      "type": "boolean",
      "default": true
    },
    "feedback_sessions": {
      "type": "boolean",
      "default": true
    },
    "certificate_issued": {
      "type": "boolean",
      "default": false
    },
    "certificate_issued_date": {
      "type": "string",
      "format": "date"
    },
    "verification_token": {
      "type": "string",
      "description": "Unique verification token for certificate verification"
    },
    "verification_url": {
      "type": "string"
    },
    "founding_wallet": {
      "type": "number",
      "default": 0
    },
    "referrals_count": {
      "type": "number",
      "default": 0
    },
    "total_rewards": {
      "type": "number",
      "default": 0
    },
    "lifetime_savings": {
      "type": "number",
      "default": 0
    },
    "votes_cast": {
      "type": "number",
      "default": 0
    },
    "accepted_suggestions": {
      "type": "number",
      "default": 0
    },
    "implemented_ideas": {
      "type": "number",
      "default": 0
    },
    "community_posts": {
      "type": "number",
      "default": 0
    },
    "community_comments": {
      "type": "number",
      "default": 0
    },
    "community_connections": {
      "type": "number",
      "default": 0
    },
    "feedback_sessions_attended": {
      "type": "number",
      "default": 0
    },
    "feedback_submitted": {
      "type": "number",
      "default": 0
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "application",
        "screening",
        "approval",
        "onboarding",
        "beta_active",
        "contributor",
        "top_contributor",
        "advisory_council",
        "general_availability",
        "lifetime_founder"
      ],
      "default": "application",
      "description": "Current lifecycle stage in the Founding Member Lifecycle Engine\u2122"
    },
    "entered_stage_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the founder entered the current lifecycle stage"
    },
    "stage_history_json": {
      "type": "string",
      "description": "JSON array of { stage, entered_date, exited_date } lifecycle transitions"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Lifecycle progress 0-100"
    },
    "next_recommended_action": {
      "type": "string",
      "description": "AI-recommended next action for lifecycle progression"
    },
    "health_score": {
      "type": "number",
      "default": 0,
      "description": "Founder Health Score 0-100"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "at_risk",
        "inactive"
      ],
      "default": "healthy"
    },
    "health_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "anniversary_count": {
      "type": "number",
      "default": 0
    },
    "last_anniversary_date": {
      "type": "string",
      "format": "date"
    },
    "ga_transitioned": {
      "type": "boolean",
      "default": false,
      "description": "Whether the founder has been transitioned to General Availability"
    },
    "ga_transitioned_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "founding_member_number",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "platform_admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "enterprise_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}