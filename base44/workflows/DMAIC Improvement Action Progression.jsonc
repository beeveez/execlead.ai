{
  "name": "DMAIC Improvement Action Progression",
  "description": "Moves linked projects into Improve when actions are created.",
  "trigger": {
    "condition": "${ (.trigger.data.target_id != null and .trigger.data.target_id != \"\" and .trigger.data.target_id != [] and .trigger.data.target_id != {}) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ContinuousImprovementAction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dmaic_improvement_action_progression",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageOperationalExcellence",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "manageOperationalExcellence"
  }
}