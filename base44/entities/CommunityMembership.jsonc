{
  "name": "CommunityMembership",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_id": {
      "type": "string",
      "description": "The user who joined this community"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_photo": {
      "type": "string"
    },
    "user_role": {
      "type": "string",
      "description": "The user's professional role/title for display"
    },
    "user_company": {
      "type": "string"
    },
    "community_id": {
      "type": "string",
      "description": "The NetworkCircle ID this membership belongs to"
    },
    "community_name": {
      "type": "string"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "member_role": {
      "type": "string",
      "enum": [
        "member",
        "moderator",
        "community_admin",
        "founder",
        "platform_admin"
      ],
      "default": "member"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "left"
      ],
      "default": "active"
    },
    "reputation": {
      "type": "number",
      "default": 0
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "posts_count": {
      "type": "number",
      "default": 0
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    },
    "referral_source": {
      "type": "string",
      "description": "How the user discovered this community (referral code, direct, etc.)"
    }
  },
  "required": [
    "user_id",
    "community_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}