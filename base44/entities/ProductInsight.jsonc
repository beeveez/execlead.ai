{
  "name": "ProductInsight",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "insight_type": {
      "type": "string",
      "enum": [
        "nps",
        "csat",
        "ces",
        "product_value",
        "feature_feedback",
        "bug_report",
        "feature_request",
        "general"
      ],
      "default": "general",
      "description": "Type of product insight or survey response"
    },
    "score": {
      "type": "number",
      "description": "Survey score (NPS 0-10, CSAT 1-5, CES 1-7)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the responding user"
    },
    "user_name": {
      "type": "string"
    },
    "most_valuable_feature": {
      "type": "string",
      "description": "Feature the user finds most valuable"
    },
    "least_valuable_feature": {
      "type": "string",
      "description": "Feature the user finds least valuable"
    },
    "missing_features": {
      "type": "string",
      "description": "Features the user wishes existed"
    },
    "feedback_text": {
      "type": "string",
      "description": "Open-ended feedback"
    },
    "likelihood_to_recommend": {
      "type": "number",
      "description": "0-10 likelihood to recommend"
    },
    "product_value_rating": {
      "type": "number",
      "description": "1-5 product value rating"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "customer_segment": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "executive",
        "enterprise",
        "founding",
        "beta"
      ],
      "description": "Customer segment at time of response"
    }
  },
  "required": [
    "insight_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}
