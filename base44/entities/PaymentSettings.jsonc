{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wise",
        "apple_pay",
        "google_pay",
        "paynow",
        "bank_transfer",
        "enterprise_invoice"
      ],
      "default": "stripe"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "pending",
        "error"
      ],
      "default": "disconnected"
    },
    "launch_mode": {
      "type": "string",
      "enum": [
        "auto",
        "development",
        "public_beta",
        "production"
      ],
      "default": "auto",
      "description": "Explicit launch mode override. 'auto' derives from payment status: connected=production, disconnected=public_beta."
    },
    "publishable_key": {
      "type": "string"
    },
    "secret_key": {
      "type": "string"
    },
    "webhook_secret": {
      "type": "string"
    },
    "supported_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_currency": {
      "type": "string",
      "default": "USD"
    },
    "tax_enabled": {
      "type": "boolean",
      "default": true
    },
    "tax_engine_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "disabled"
      ],
      "default": "automatic"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 0
    },
    "trial_enabled": {
      "type": "boolean",
      "default": true
    },
    "trial_duration_days": {
      "type": "number",
      "default": 14
    },
    "min_coupon_value": {
      "type": "number",
      "default": 0
    },
    "max_coupon_value": {
      "type": "number",
      "default": 100
    },
    "refund_window_days": {
      "type": "number",
      "default": 30
    },
    "parent_company": {
      "type": "string",
      "default": "Meridian Wellspring Holdings Pte. Ltd."
    },
    "parent_company_country": {
      "type": "string",
      "default": "Singapore"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    }
  }
}