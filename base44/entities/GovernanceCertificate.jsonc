{
  "name": "GovernanceCertificate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "certificate_id": {
      "type": "string",
      "description": "Unique governance certificate identifier"
    },
    "trigger": {
      "type": "string",
      "description": "Platform event that triggered the pipeline run"
    },
    "certified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the platform passed governance certification"
    },
    "overall_governance_score": {
      "type": "number",
      "default": 0,
      "description": "Overall governance score 0-100"
    },
    "manifest_health": {
      "type": "number",
      "default": 0
    },
    "registry_health": {
      "type": "number",
      "default": 0
    },
    "knowledge_health": {
      "type": "number",
      "default": 0
    },
    "synchronization_health": {
      "type": "number",
      "default": 0
    },
    "deployment_readiness": {
      "type": "number",
      "default": 0
    },
    "platform_state": {
      "type": "number",
      "default": 0
    },
    "enterprise_readiness": {
      "type": "number",
      "default": 0
    },
    "warnings": {
      "type": "number",
      "default": 0
    },
    "failures": {
      "type": "number",
      "default": 0
    },
    "repair_actions": {
      "type": "number",
      "default": 0,
      "description": "Number of findings that can be auto-repaired"
    },
    "stages_json": {
      "type": "string",
      "description": "JSON array of 16 pipeline stage results"
    },
    "findings_json": {
      "type": "string",
      "description": "JSON array of all findings with drill-down data"
    },
    "pipeline_version": {
      "type": "string"
    },
    "platform_version": {
      "type": "string"
    },
    "execution_time_ms": {
      "type": "number",
      "default": 0
    },
    "user_id": {
      "type": "string",
      "description": "Developer who triggered the pipeline, or 'system'"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string",
      "description": "Role of the authenticated user who created this record (audit)"
    },
    "request_id": {
      "type": "string",
      "description": "Correlation ID for the create operation (audit traceability)"
    }
  },
  "required": [
    "certificate_id",
    "trigger"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "developer"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "platform_admin"
          }
        },
        {
          "user_condition": {
            "role": "founder_root_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__immutable__"
      }
    }
  }
}